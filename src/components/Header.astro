---
import { nav, site } from '../data/site';
import Icon from './Icon.astro';
const path = Astro.url.pathname;
const isActive = (href: string) => (href === '/' ? path === '/' : path.startsWith(href));
---
<header class="hdr" transition:persist>
  <div class="w bar">
    <a class="logo" href="/" aria-label={`${site.name} – accueil`}>
      <span class="mark"><Icon name="paw" size={20} /></span>
      <span><strong>Pauline Renard</strong><small>Éducation canine · Lyon</small></span>
    </a>
    <nav class="links" aria-label="Navigation principale">
      {nav.map((l) => <a href={l.href} data-nav={l.href} aria-current={isActive(l.href) ? 'page' : undefined}>{l.label}</a>)}
    </nav>
    <a class="btn accent cta" href="/contact/">Me contacter</a>
    <button class="burger" aria-label="Ouvrir le menu" aria-expanded="false" aria-controls="mnav">
      <Icon name="menu" class="i-open" /><Icon name="close" class="i-close" />
    </button>
  </div>
  <nav id="mnav" class="mnav" aria-label="Navigation mobile">
    {nav.map((l, i) => <a href={l.href} data-nav={l.href} style={`--i:${i}`}>{l.label}</a>)}
    <a href="/contact/" data-nav="/contact/" style={`--i:${nav.length}`}>Contact</a>
    <a class="btn accent" href={site.phoneHref} style={`--i:${nav.length + 1}`}><Icon name="phone" size={18} /> {site.phone}</a>
  </nav>
</header>

<style>
  .hdr { position: sticky; top: 0; z-index: 50; transition: background .4s, box-shadow .4s, backdrop-filter .4s; }
  .hdr.scrolled { background: color-mix(in srgb, var(--bg) 82%, transparent); backdrop-filter: blur(14px) saturate(1.4); -webkit-backdrop-filter: blur(14px) saturate(1.4); box-shadow: 0 1px 0 var(--line); }
  .bar { display: flex; align-items: center; gap: 20px; height: 76px; }
  .logo { display: flex; align-items: center; gap: 12px; text-decoration: none; color: var(--ink); margin-right: auto; }
  .logo strong { display: block; font-family: var(--serif); font-size: 1.15rem; line-height: 1.1; }
  .logo small { display: block; color: var(--mut); font-size: .78rem; letter-spacing: .02em; }
  .mark { display: grid; place-items: center; width: 42px; height: 42px; border-radius: 14px; background: var(--green); color: var(--on); transition: transform .5s var(--ease); }
  .logo:hover .mark { transform: rotate(-12deg) scale(1.06); }
  .links { display: none; gap: 4px; }
  .links a { position: relative; padding: 8px 14px; border-radius: 999px; color: var(--ink); text-decoration: none; font-weight: 500; font-size: .97rem; transition: background .25s; }
  .links a:hover { background: var(--green-soft); }
  .links a[aria-current='page'] { color: var(--green2); font-weight: 700; }
  .links a[aria-current='page']::after { content: ''; position: absolute; left: 50%; bottom: 2px; width: 5px; height: 5px; border-radius: 50%; background: var(--accent); transform: translateX(-50%); }
  .cta { display: none; padding: 12px 20px; }
  .burger { display: grid; place-items: center; width: 46px; height: 46px; border-radius: 14px; border: 1px solid var(--line); background: var(--card); color: var(--ink); cursor: pointer; }
  .burger :global(.i-close), .hdr.open .burger :global(.i-open) { display: none; }
  .hdr.open .burger :global(.i-close) { display: block; }
  .mnav { position: fixed; inset: 76px 0 0; background: var(--bg); padding: 24px 22px 40px; display: flex; flex-direction: column; gap: 6px; opacity: 0; visibility: hidden; transition: opacity .35s, visibility .35s; overflow-y: auto; }
  .mnav a:not(.btn) { font-family: var(--serif); font-size: 2rem; color: var(--ink); text-decoration: none; padding: 8px 0; border-bottom: 1px solid var(--line); }
  .mnav a { opacity: 0; transform: translateY(16px); transition: opacity .5s var(--ease), transform .5s var(--ease); transition-delay: calc(var(--i) * 45ms); }
  .mnav .btn { margin-top: 20px; align-self: flex-start; }
  .hdr.open .mnav { opacity: 1; visibility: visible; }
  .hdr.open .mnav a { opacity: 1; transform: none; }
  .hdr.open { background: var(--bg); }
  @media (min-width: 1000px) {
    .links, .cta { display: flex; }
    .burger, .mnav { display: none; }
  }
</style>

<script>
  const hdr = document.querySelector<HTMLElement>('.hdr')!;
  const burger = hdr.querySelector<HTMLButtonElement>('.burger')!;
  const setOpen = (o: boolean) => {
    hdr.classList.toggle('open', o);
    burger.setAttribute('aria-expanded', String(o));
    document.documentElement.style.overflow = o ? 'hidden' : '';
  };
  burger.addEventListener('click', () => setOpen(!hdr.classList.contains('open')));
  const onScroll = () => hdr.classList.toggle('scrolled', scrollY > 10);
  addEventListener('scroll', onScroll, { passive: true });
  document.addEventListener('astro:page-load', () => {
    setOpen(false);
    onScroll();
    const p = location.pathname;
    hdr.querySelectorAll<HTMLAnchorElement>('[data-nav]').forEach((a) => {
      const h = a.dataset.nav!;
      const on = h === '/' ? p === '/' : p.startsWith(h);
      on ? a.setAttribute('aria-current', 'page') : a.removeAttribute('aria-current');
    });
  });
</script>
