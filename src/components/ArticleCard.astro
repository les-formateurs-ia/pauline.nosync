---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import Icon from './Icon.astro';
interface Props { entry: CollectionEntry<'conseils'>; i?: number }
const { entry } = Astro.props;
const { title, description, category, cover, coverAlt, readingTime } = entry.data;
---
<a class="art" href={`/conseils/${entry.id}/`} data-cat={category}>
  <div class="photo cover"><Image src={cover} alt={coverAlt} widths={[400, 640]} sizes="(min-width: 800px) 380px, 90vw" loading="lazy" /></div>
  <div class="meta"><span>{category}</span><span>·</span><span>{readingTime} min de lecture</span></div>
  <h3>{title}</h3>
  <p>{description}</p>
  <span class="more">Lire l’article <Icon name="arrow" size={16} /></span>
</a>
<style>
  .art { display: flex; flex-direction: column; text-decoration: none; }
  .cover { aspect-ratio: 4 / 3; margin-bottom: 20px; }
  .cover img { transition: transform 1.2s var(--ease); }
  .art:hover .cover img { transform: scale(1.04); }
  .meta { display: flex; gap: 8px; font-size: .8rem; font-weight: 500; letter-spacing: .06em; text-transform: uppercase; color: var(--sage); margin-bottom: 10px; }
  h3 { font-size: 1.35rem; margin-bottom: 8px; transition: color .2s; }
  .art:hover h3 { color: var(--sage); }
  p { color: var(--ink2); font-size: .97rem; flex: 1; }
  .more { display: inline-flex; align-items: center; gap: 8px; font-weight: 500; font-size: .93rem; }
  .more :global(svg) { transition: transform .3s var(--ease); }
  .art:hover .more :global(svg) { transform: translateX(4px); }
</style>
