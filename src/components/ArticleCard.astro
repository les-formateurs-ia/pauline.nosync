---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import Icon from './Icon.astro';
interface Props { entry: CollectionEntry<'conseils'>; i?: number }
const { entry, i = 0 } = Astro.props;
const { title, description, category, cover, coverAlt, readingTime } = entry.data;
const colors: Record<string, string> = { Éducation: 'sun', Comportement: 'pink', Chiot: 'sky', Quotidien: 'mint' };
const tilt = [-1.5, 1, -0.5, 1.5][i % 4];
---
<a class="art" href={`/conseils/${entry.id}/`} data-cat={category} style={`--c: var(--${colors[category]}); --t:${tilt}deg`}>
  <div class="cover"><Image src={cover} alt={coverAlt} widths={[400, 640]} sizes="(min-width: 780px) 380px, 90vw" loading="lazy" /></div>
  <div class="body">
    <div class="meta"><span class="pill">{category}</span><span class="time"><Icon name="clock" size={15} /> {readingTime} min</span></div>
    <h3>{title}</h3>
    <p>{description}</p>
    <span class="more">Lire <span class="arr"><Icon name="arrow" size={16} /></span></span>
  </div>
</a>
<style>
  .art { display: flex; flex-direction: column; background: var(--white); border: var(--line); border-radius: 24px; overflow: hidden; text-decoration: none; transform: rotate(var(--t)); transition: transform .45s var(--spring), box-shadow .35s var(--ease); }
  .art:hover { transform: rotate(0) translate(-4px, -6px); box-shadow: var(--hard-lg); }
  .cover { aspect-ratio: 16 / 11; overflow: hidden; border-bottom: var(--line); }
  .cover img { width: 100%; height: 100%; object-fit: cover; transition: transform .9s var(--ease); }
  .art:hover .cover img { transform: scale(1.07) rotate(1deg); }
  .body { padding: 20px 22px 22px; display: flex; flex-direction: column; flex: 1; background: linear-gradient(var(--c), var(--c)) bottom / 100% 0 no-repeat; transition: background-size .5s var(--ease); }
  .art:hover .body { background-size: 100% 100%; }
  .meta { display: flex; justify-content: space-between; align-items: center; margin-bottom: 14px; }
  .pill { background: var(--c); }
  .time { display: inline-flex; align-items: center; gap: 5px; font-size: .88rem; font-weight: 600; }
  h3 { margin-bottom: 8px; }
  p { font-size: .98rem; color: var(--ink2); flex: 1; }
  .more { display: inline-flex; align-items: center; gap: 8px; font-weight: 700; }
  .arr { display: grid; place-items: center; width: 32px; height: 32px; border: 2px solid var(--ink); border-radius: 50%; background: var(--white); transition: transform .4s var(--spring); }
  .art:hover .arr { transform: rotate(-30deg) scale(1.1); }
</style>
