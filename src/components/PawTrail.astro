---
// Animated trail of paw prints walking along a gentle curve.
interface Props { class?: string; count?: number }
const { class: cls, count = 9 } = Astro.props;
const prints = Array.from({ length: count }, (_, i) => {
  const t = i / (count - 1);
  const x = 20 + t * 560;
  const y = 120 - Math.sin(t * Math.PI) * 70 + (i % 2 ? 14 : -14);
  const angle = 90 - Math.cos(t * Math.PI) * 30;
  return { x, y, angle, i };
});
---
<svg class:list={['trail', cls]} viewBox="0 0 600 160" aria-hidden="true">
  {prints.map((p) => (
    <use href="#paw-sym" width="26" height="26" x="-13" y="-13" transform={`translate(${p.x} ${p.y}) rotate(${p.angle})`} style={`--i:${p.i}`} />
  ))}
</svg>
<style>
  .trail { color: var(--accent); overflow: visible; }
  use { opacity: 0; animation: step 6s infinite; animation-delay: calc(var(--i) * 300ms); transform-box: fill-box; }
  @keyframes step {
    0% { opacity: 0; }
    4% { opacity: .9; }
    45% { opacity: .9; }
    65%, 100% { opacity: 0; }
  }
  @media (prefers-reduced-motion: reduce) { use { opacity: .5; animation: none; } }
</style>
