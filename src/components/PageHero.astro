---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
interface Props { label: string; title: string; lead?: string; image?: ImageMetadata; alt?: string }
const { label, title, lead, image, alt = '' } = Astro.props;
---
<section class:list={['phero', { 'with-img': image }]} data-hero>
  <div class="w grid-h">
    <div class="txt">
      <p class="label" data-reveal>{label}</p>
      <h1 data-split set:html={title} />
      {lead && <p class="lead" data-reveal>{lead}</p>}
      <div data-reveal><slot /></div>
    </div>
    {image && <div class="photo pimg" data-img><Image src={image} alt={alt} widths={[400, 675]} sizes="(min-width: 900px) 440px, 90vw" loading="eager" /></div>}
  </div>
</section>
<style>
  .phero { padding: clamp(56px, 8vw, 110px) 0 clamp(56px, 7vw, 90px); border-bottom: 1px solid var(--line); }
  .grid-h { display: grid; gap: 48px; align-items: end; }
  @media (min-width: 900px) { .with-img .grid-h { grid-template-columns: 1.3fr .7fr; } }
  .txt h1 { max-width: 16ch; }
  .pimg { aspect-ratio: 4 / 5; max-height: 520px; }
  @media (max-width: 899px) { .pimg { aspect-ratio: 16 / 10; } }
</style>
