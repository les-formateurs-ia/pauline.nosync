---
import OsloAvatar from './OsloAvatar.astro';
interface Props { title?: string; size?: number; class?: string; color?: string }
const { title = 'Le conseil d’Oslo', size = 56, class: cls } = Astro.props;
---
<aside class:list={['oslo-tip', cls]} data-reveal>
  <OsloAvatar size={size} />
  <div>
    <p class="t">{title}</p>
    <div class="txt"><slot /></div>
  </div>
</aside>
<style>
  .oslo-tip { display: flex; gap: 18px; align-items: flex-start; margin: 36px 0; padding: 22px 24px; background: var(--white); border: 1px solid var(--line); border-left: 3px solid var(--sage); border-radius: 4px var(--r) var(--r) 4px; }
  .t { font-family: var(--serif); font-style: italic; font-size: 1.25rem; color: var(--sage); margin: 0 0 4px; line-height: 1.2; }
  .txt { color: var(--ink2); font-size: 1rem; }
  .txt :global(p:last-child) { margin: 0; }
  .txt :global(strong) { color: var(--ink); font-weight: 600; }
</style>
