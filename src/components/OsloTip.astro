---
import OsloAvatar from './OsloAvatar.astro';
interface Props { title?: string; size?: number; class?: string }
const { title = 'Le conseil d’Oslo', size = 96, class: cls } = Astro.props;
---
<aside class:list={['oslo-tip', 'oslo-host', 'rv', cls]}>
  <div class="av"><OsloAvatar size={size} /></div>
  <div class="bubble">
    <p class="t">{title}</p>
    <div class="txt"><slot /></div>
  </div>
</aside>
<style>
  .oslo-tip { display: flex; gap: 18px; align-items: flex-end; margin: 40px 0; }
  .av { flex: none; animation: hop 4s ease-in-out infinite; }
  @keyframes hop { 0%, 88%, 100% { transform: none; } 92% { transform: translateY(-8px); } 96% { transform: none; } }
  .bubble { position: relative; background: var(--card); border: 1px solid var(--line); border-radius: 24px 24px 24px 6px; padding: 20px 24px; box-shadow: var(--shadow); flex: 1; }
  .bubble::before { content: ''; position: absolute; left: -9px; bottom: 14px; width: 16px; height: 16px; background: var(--card); border-left: 1px solid var(--line); border-bottom: 1px solid var(--line); transform: rotate(45deg); }
  .t { font-family: var(--serif); font-weight: 650; font-size: 1.15rem; color: var(--accent); margin: 0 0 6px; }
  .txt { color: var(--ink); }
  .txt :global(p:last-child) { margin: 0; }
  @media (max-width: 520px) { .oslo-tip { flex-direction: column; align-items: flex-start; } .bubble { border-radius: 6px 24px 24px 24px; } .bubble::before { left: 26px; top: -9px; bottom: auto; transform: rotate(135deg); } }
  @media (prefers-reduced-motion: reduce) { .av { animation: none; } }
</style>
