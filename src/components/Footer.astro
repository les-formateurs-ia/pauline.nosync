---
import { nav, site } from '../data/site';
import Icon from './Icon.astro';
import OsloRun from './OsloRun.astro';
---
<footer class="ft">
  <div class="w">
    <div class="cta">
      <div class="run-lane" aria-hidden="true"><div class="runner"><OsloRun size={190} /></div></div>
      <p class="kicker hand">Prêt·e à avancer ?</p>
      <h2 data-split>On se rencontre&nbsp;?</h2>
      <p class="sub">Racontez-moi votre situation : on commence par une séance bilan pour faire connaissance, chez vous ou en balade.</p>
      <div class="btns">
        <a class="btn sun" href="/contact/">Réserver une séance bilan <Icon name="arrow" size={18} /></a>
        <a class="btn white" href={site.phoneHref}><Icon name="phone" size={18} /> {site.phone}</a>
      </div>
    </div>
  </div>
  <div class="base">
    <div class="w cols">
      <div>
        <p class="brand">Pauline Renard</p>
        <p>{site.role} à Lyon.<br />Diplômée EFM Métiers Animaliers · ACACED</p>
      </div>
      <div>
        <p class="t hand">Explorer</p>
        <ul>{nav.map((l) => <li><a href={l.href}>{l.label}</a></li>)}<li><a href="/contact/">Contact</a></li></ul>
      </div>
      <div>
        <p class="t hand">Me joindre</p>
        <ul>
          <li><a href={site.phoneHref}>{site.phone}</a></li>
          <li><a href={`mailto:${site.email}`}>{site.email}</a></li>
          <li>{site.city} · {site.area}</li>
        </ul>
      </div>
    </div>
    <p class="copy w">© {new Date().getFullYear()} Pauline Renard · Fait avec ♥ (et l’aide d’Oslo) à Lyon</p>
  </div>
  <svg width="0" height="0" style="position:absolute" aria-hidden="true">
    <symbol id="paw-sym" viewBox="0 0 24 24"><g fill="currentColor"><ellipse cx="12" cy="15.5" rx="5" ry="4.2"/><ellipse cx="5.5" cy="10" rx="2.2" ry="2.8"/><ellipse cx="18.5" cy="10" rx="2.2" ry="2.8"/><ellipse cx="9" cy="5" rx="2" ry="2.6"/><ellipse cx="15" cy="5" rx="2" ry="2.6"/></g></symbol>
  </svg>
</footer>

<style>
  .ft { margin-top: clamp(40px, 6vw, 80px); }
  .cta { position: relative; overflow: hidden; background: var(--tomato); border: var(--line); border-radius: 40px; padding: clamp(110px, 12vw, 150px) clamp(28px, 6vw, 80px) clamp(40px, 6vw, 72px); box-shadow: var(--hard-lg); }
  .cta h2 { font-size: clamp(3rem, 9vw, 7.5rem); margin: 0 0 18px; }
  .cta .kicker { color: var(--ink); }
  .sub { font-size: 1.2rem; max-width: 46ch; margin-bottom: 28px; }
  .run-lane { position: absolute; left: 0; right: 0; top: 18px; height: 120px; border-bottom: 2.5px dashed rgb(23 21 15 / .35); }
  .runner { position: absolute; bottom: -4px; animation: lane 9s linear infinite; }
  @keyframes lane { from { transform: translateX(-240px); } to { transform: translateX(calc(100vw + 40px)); } }
  .base { margin-top: 56px; border-top: var(--line); padding: 48px 0 28px; }
  .cols { display: grid; gap: 32px; }
  @media (min-width: 780px) { .cols { grid-template-columns: 1.5fr 1fr 1.3fr; } }
  .brand { font-family: var(--display); font-weight: 800; font-stretch: 80%; font-size: 2.2rem; letter-spacing: -.03em; line-height: 1; margin-bottom: 10px; }
  .t { font-size: 1.5rem; color: var(--tomato); margin-bottom: 8px; }
  ul { list-style: none; padding: 0; margin: 0; display: grid; gap: 6px; }
  ul a { text-decoration: none; font-weight: 600; }
  ul a:hover { text-decoration: underline; text-decoration-color: var(--tomato); }
  .copy { margin-top: 40px; font-size: .9rem; color: var(--ink2); }
</style>
