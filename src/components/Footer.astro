---
import { nav, site } from '../data/site';
import Icon from './Icon.astro';
---
<footer class="ft">
  <section class="cta bg-dark">
    <div class="w cta-grid">
      <div>
        <p class="label">Prendre rendez-vous</p>
        <h2 data-split>Commençons par <em>faire connaissance</em>.</h2>
      </div>
      <div>
        <p class="sub">La séance bilan permet d’observer votre chien, de comprendre votre quotidien et de définir ensemble un plan adapté.</p>
        <div class="btns">
          <a class="btn light" href="/contact/">Réserver une séance bilan <Icon name="arrow" size={17} /></a>
          <a class="link" href={site.phoneHref}>{site.phone}</a>
        </div>
      </div>
    </div>
  </section>
  <div class="base">
    <div class="w cols">
      <div>
        <p class="brand">Pauline Renard</p>
        <p class="muted">{site.role} à Lyon.<br />Diplômée EFM Métiers Animaliers · Titulaire de l’ACACED</p>
      </div>
      <div>
        <p class="t">Navigation</p>
        <ul>{nav.map((l) => <li><a href={l.href}>{l.label}</a></li>)}<li><a href="/contact/">Contact</a></li></ul>
      </div>
      <div>
        <p class="t">Contact</p>
        <ul>
          <li><a href={site.phoneHref}>{site.phone}</a></li>
          <li><a href={`mailto:${site.email}`}>{site.email}</a></li>
          <li class="muted">{site.city} · {site.area}</li>
        </ul>
      </div>
    </div>
    <div class="w bottom"><span>© {new Date().getFullYear()} Pauline Renard</span><span>Éducatrice &amp; comportementaliste canin · Lyon</span></div>
  </div>
  <svg width="0" height="0" style="position:absolute" aria-hidden="true">
    <symbol id="paw-sym" viewBox="0 0 24 24"><g fill="currentColor"><ellipse cx="12" cy="15.5" rx="5" ry="4.2"/><ellipse cx="5.5" cy="10" rx="2.2" ry="2.8"/><ellipse cx="18.5" cy="10" rx="2.2" ry="2.8"/><ellipse cx="9" cy="5" rx="2" ry="2.6"/><ellipse cx="15" cy="5" rx="2" ry="2.6"/></g></symbol>
  </svg>
</footer>
<style>
  .cta { padding: clamp(80px, 10vw, 130px) 0; }
  .cta-grid { display: grid; gap: 40px; align-items: end; }
  @media (min-width: 900px) { .cta-grid { grid-template-columns: 1.2fr .8fr; } }
  .cta .label { color: #c9dccd; }
  .cta h2 { margin: 0; color: #fff; font-size: clamp(2.3rem, 5vw, 4rem); }
  .sub { color: rgb(241 243 239 / .78); font-size: 1.08rem; margin-bottom: 26px; }
  .cta .link { color: #fff; }
  .base { padding: 60px 0 30px; }
  .cols { display: grid; gap: 36px; padding-bottom: 48px; border-bottom: 1px solid var(--line); }
  @media (min-width: 800px) { .cols { grid-template-columns: 1.6fr 1fr 1.2fr; } }
  .brand { font-family: var(--display); font-weight: 500; font-size: 1.6rem; letter-spacing: -.03em; margin-bottom: 8px; }
  .t { font-size: .76rem; font-weight: 600; letter-spacing: .14em; text-transform: uppercase; color: var(--ink3); margin-bottom: 14px; }
  ul { list-style: none; padding: 0; margin: 0; display: grid; gap: 8px; }
  ul a { text-decoration: none; color: var(--ink2); transition: color .2s; }
  ul a:hover { color: var(--sage); }
  .bottom { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 10px; padding-top: 26px; font-size: .85rem; color: var(--ink3); }
</style>
