---
// Hand-made, looping SVG illustrations — one per concept of the site.
// Available: ball puppy heart house tree paws chat magnifier bulb stairs sprout sheep niche hole moon bird nose duck bone cushion plane ticket star
interface Props { name: string; size?: number; class?: string }
const { name, size = 140, class: cls } = Astro.props;
const INK = '#17150f', SUN = '#ffc93c', TOM = '#ff5b3a', PINK = '#ffb7cb', SKY = '#9fd8ff', MINT = '#bfe9cf', GRASS = '#1f9d55', LILAC = '#cdbcff', W = '#fff', TAN = '#c8763a', BLK = '#1c1c1e', DIRT = '#a8754a';
---
<svg class:list={['il', `il-${name}`, cls]} width={size} height={size} viewBox="0 0 160 160" fill="none" stroke={INK} stroke-width="4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
  {name === 'ball' && (
    <g>
      <ellipse class="sh" cx="80" cy="142" rx="30" ry="6" fill={INK} stroke="none" opacity=".15" />
      <g class="bb"><g class="bs">
        <circle cx="80" cy="60" r="28" fill={SUN} />
        <path d="M55 50 C70 60 90 60 105 50" /><path d="M55 72 C70 63 90 63 105 72" />
      </g></g>
    </g>
  )}
  {name === 'puppy' && (
    <g>
      <path class="tail" d="M44 104 C28 98 24 82 32 70" stroke-width="6" />
      <ellipse cx="72" cy="108" rx="34" ry="24" fill={BLK} />
      <path d="M86 92 C98 94 104 112 100 130 L76 130 C76 114 78 100 86 92Z" fill={W} />
      <ellipse cx="62" cy="133" rx="11" ry="6" fill={W} /><ellipse cx="90" cy="133" rx="11" ry="6" fill={W} />
      <g class="phead">
        <circle cx="100" cy="68" r="27" fill={BLK} />
        <ellipse cx="114" cy="80" rx="15" ry="11" fill={W} />
        <path d="M86 50 C72 52 68 72 74 86 C82 82 88 68 92 56Z" fill={BLK} />
        <ellipse cx="106" cy="57" rx="4.5" ry="3" fill={TAN} stroke="none" />
        <circle cx="104" cy="66" r="4" fill={W} stroke="none" /><circle cx="105" cy="66" r="2.2" fill={INK} stroke="none" />
        <circle cx="127" cy="76" r="4.5" fill={INK} />
        <path class="tg" d="M116 88 C116 98 124 98 124 88Z" fill={PINK} stroke-width="3" />
      </g>
    </g>
  )}
  {name === 'heart' && (
    <g>
      <g class="beat">
        <path d="M80 134 C28 102 20 64 46 47 C63 37 76 46 80 58 C84 46 97 37 114 47 C140 64 132 102 80 134Z" fill={TOM} />
        <g transform="rotate(-32 80 84)"><rect x="58" y="74" width="44" height="20" rx="6" fill={W} /><circle cx="74" cy="84" r="1.6" fill={INK} stroke="none" /><circle cx="80" cy="80" r="1.6" fill={INK} stroke="none" /><circle cx="86" cy="88" r="1.6" fill={INK} stroke="none" /></g>
      </g>
      <path class="spk s1" d="M28 30 L31 38 L39 41 L31 44 L28 52 L25 44 L17 41 L25 38Z" fill={SUN} stroke-width="3" />
      <path class="spk s2" d="M132 22 L134 28 L140 30 L134 32 L132 38 L130 32 L124 30 L130 28Z" fill={SUN} stroke-width="3" />
      <path class="spk s3" d="M138 112 L140 118 L146 120 L140 122 L138 128 L136 122 L130 120 L136 118Z" fill={SUN} stroke-width="3" />
    </g>
  )}
  {name === 'house' && (
    <g>
      <circle class="smk k1" cx="98" cy="34" r="6" fill={W} /><circle class="smk k2" cx="98" cy="34" r="6" fill={W} /><circle class="smk k3" cx="98" cy="34" r="6" fill={W} />
      <rect x="90" y="40" width="14" height="24" fill={TOM} />
      <rect x="36" y="72" width="76" height="62" fill={W} />
      <path d="M26 78 L74 34 L122 78Z" fill={TOM} />
      <rect x="64" y="100" width="20" height="34" fill={SUN} />
      <rect x="44" y="86" width="14" height="14" fill={SKY} /><rect x="90" y="86" width="14" height="14" fill={SKY} />
      <g class="box"><rect x="112" y="110" width="34" height="26" fill="#e7b878" /><path d="M129 110 V122" /><path d="M112 118 H146" stroke-width="2.5" /></g>
      <path d="M14 136 H150" />
    </g>
  )}
  {name === 'tree' && (
    <g>
      <path d="M80 140 V96" stroke-width="10" stroke={INK} /><path d="M80 140 V96" stroke-width="4" stroke={DIRT} />
      <g class="crown"><circle cx="80" cy="66" r="38" fill={GRASS} /><circle cx="56" cy="80" r="20" fill={GRASS} /><circle cx="104" cy="80" r="20" fill={GRASS} /><path d="M66 56 C70 50 76 48 82 48" stroke={W} stroke-width="3" /></g>
      <ellipse class="leaf l1" cx="50" cy="96" rx="6" ry="3.5" fill={SUN} stroke-width="2.5" />
      <ellipse class="leaf l2" cx="110" cy="92" rx="6" ry="3.5" fill={MINT} stroke-width="2.5" />
      <ellipse class="leaf l3" cx="84" cy="100" rx="6" ry="3.5" fill={TOM} stroke-width="2.5" />
      <path d="M20 140 H140" />
    </g>
  )}
  {name === 'paws' && (
    <g fill={INK} stroke="none">
      {[[34, 124, -20], [62, 96, 10], [70, 62, -20], [100, 40, 10], [112, 10, -20]].map(([x, y, r], i) => (
        <g class="pw" style={`--i:${i}`} transform={`translate(${x} ${y}) rotate(${r} 14 14)`}>
          <ellipse cx="14" cy="18" rx="8" ry="7" /><ellipse cx="3" cy="9" rx="3.4" ry="4.4" /><ellipse cx="25" cy="9" rx="3.4" ry="4.4" /><ellipse cx="9" cy="2" rx="3.2" ry="4.2" /><ellipse cx="19" cy="2" rx="3.2" ry="4.2" />
        </g>
      ))}
    </g>
  )}
  {name === 'chat' && (
    <g>
      <path class="bub" d="M24 40 Q24 26 38 26 H122 Q136 26 136 40 V92 Q136 106 122 106 H64 L40 128 L44 106 H38 Q24 106 24 92Z" fill={SKY} />
      <circle class="dt d1" cx="56" cy="66" r="7" fill={INK} stroke="none" /><circle class="dt d2" cx="80" cy="66" r="7" fill={INK} stroke="none" /><circle class="dt d3" cx="104" cy="66" r="7" fill={INK} stroke="none" />
      <path class="hrt" d="M132 128 C120 120 118 110 124 106 C128 104 131 106 132 109 C133 106 136 104 140 106 C146 110 144 120 132 128Z" fill={TOM} stroke-width="3" />
    </g>
  )}
  {name === 'magnifier' && (
    <g>
      <g fill={INK} stroke="none" opacity=".9"><ellipse cx="80" cy="104" rx="15" ry="13" /><ellipse cx="60" cy="86" rx="6" ry="8" /><ellipse cx="100" cy="86" rx="6" ry="8" /><ellipse cx="70" cy="72" rx="5.5" ry="7.5" /><ellipse cx="90" cy="72" rx="5.5" ry="7.5" /></g>
      <g class="mg"><path d="M98 98 L126 126" stroke-width="12" /><path d="M98 98 L126 126" stroke-width="5" stroke={TOM} /><circle cx="78" cy="78" r="30" fill={SKY} fill-opacity=".55" stroke-width="6" /><path d="M62 66 C66 58 74 54 82 54" stroke={W} stroke-width="4" /></g>
    </g>
  )}
  {name === 'bulb' && (
    <g>
      <g class="rays" stroke-width="5"><path d="M80 10 V22" /><path d="M128 30 L120 38" /><path d="M32 30 L40 38" /><path d="M146 76 H134" /><path d="M14 76 H26" /></g>
      <path class="glass" d="M80 32 C56 32 44 50 44 68 C44 86 58 94 62 108 H98 C102 94 116 86 116 68 C116 50 104 32 80 32Z" fill={SUN} />
      <path d="M68 92 L74 78 L80 90 L86 78 L92 92" stroke-width="3" />
      <rect x="62" y="108" width="36" height="12" rx="3" fill={W} /><rect x="66" y="120" width="28" height="10" rx="3" fill={W} /><path d="M74 136 H86" />
    </g>
  )}
  {name === 'stairs' && (
    <g>
      <path d="M16 140 H52 V112 H88 V84 H124 V56 H146 V140 Z" fill={MINT} />
      <g class="climb"><circle cx="34" cy="126" r="11" fill={TOM} /></g>
      <path d="M128 56 V20" /><path class="flag" d="M128 20 L152 28 L128 36Z" fill={SUN} stroke-width="3" />
    </g>
  )}
  {name === 'sprout' && (
    <g>
      <g class="grow">
        <path d="M80 112 V58" stroke={GRASS} stroke-width="6" />
        <path class="lf1" d="M80 80 C64 82 50 72 46 56 C62 54 76 62 80 80Z" fill={MINT} />
        <path class="lf2" d="M80 66 C96 68 110 58 114 42 C98 40 84 48 80 66Z" fill={GRASS} />
      </g>
      <path d="M50 108 H110 L102 142 H58Z" fill={TOM} /><path d="M46 104 H114 V114 H46Z" fill={TOM} />
    </g>
  )}
  {name === 'sheep' && (
    <g>
      <path d="M86 138 V104 M120 138 V104 M80 112 H126 M80 128 H126" stroke-width="5" stroke={DIRT} />
      <path d="M10 140 H150" />
      <g class="jump">
        <path d="M30 96 v16 M50 96 v16" stroke-width="5" />
        <g fill={W}><circle cx="30" cy="80" r="12" /><circle cx="44" cy="74" r="13" /><circle cx="56" cy="82" r="12" /><circle cx="40" cy="90" r="12" /><circle cx="54" cy="94" r="10" /></g>
        <ellipse cx="66" cy="76" rx="9" ry="11" fill={INK} /><circle cx="68" cy="73" r="2" fill={W} stroke="none" />
      </g>
    </g>
  )}
  {name === 'niche' && (
    <g>
      <path d="M26 66 L80 26 L134 66" fill={TOM} />
      <rect x="34" y="62" width="92" height="74" fill={SKY} />
      <path d="M58 136 V104 Q58 84 80 84 Q102 84 102 104 V136Z" fill={INK} />
      <clipPath id="door-clip"><path d="M58 136 V104 Q58 84 80 84 Q102 84 102 104 V136Z" /></clipPath>
      <g clip-path="url(#door-clip)"><g class="peek">
        <circle cx="80" cy="116" r="17" fill={BLK} stroke-width="3" /><path d="M80 102 C77 106 76 116 75 122 C70 126 72 134 80 134 C88 134 90 126 85 122 C84 116 83 106 80 102Z" fill={W} stroke="none" />
        <circle cx="74" cy="112" r="2.5" fill={W} stroke="none" /><circle cx="86" cy="112" r="2.5" fill={W} stroke="none" /><ellipse cx="80" cy="124" rx="4" ry="3" fill={INK} stroke="none" />
      </g></g>
      <rect x="66" y="42" width="28" height="12" rx="4" fill={SUN} stroke-width="3" />
      <path d="M14 136 H146" />
    </g>
  )}
  {name === 'hole' && (
    <g>
      <circle class="drt t1" cx="80" cy="104" r="5" fill={DIRT} stroke-width="2.5" /><circle class="drt t2" cx="80" cy="104" r="4" fill={DIRT} stroke-width="2.5" /><circle class="drt t3" cx="80" cy="104" r="6" fill={DIRT} stroke-width="2.5" /><circle class="drt t4" cx="80" cy="104" r="4" fill={DIRT} stroke-width="2.5" />
      <path class="ttail" d="M80 112 C80 96 76 84 86 74" stroke-width="9" />
      <path class="ttail" d="M80 112 C80 96 76 84 86 74" stroke-width="3" stroke={W} />
      <path d="M20 140 C30 112 56 104 80 104 C104 104 130 112 140 140Z" fill={DIRT} />
      <ellipse cx="80" cy="112" rx="24" ry="7" fill={INK} />
    </g>
  )}
  {name === 'moon' && (
    <g>
      <path class="mn" d="M104 22 C80 26 66 46 68 68 C70 90 90 104 112 100 C96 116 64 112 50 90 C36 66 52 30 80 22 C88 20 96 20 104 22Z" fill={SUN} />
      <path class="tw a" d="M30 30 L32 36 L38 38 L32 40 L30 46 L28 40 L22 38 L28 36Z" fill={W} stroke-width="2.5" />
      <path class="tw b" d="M128 56 L130 62 L136 64 L130 66 L128 72 L126 66 L120 64 L126 62Z" fill={W} stroke-width="2.5" />
      <path d="M8 142 L46 96 L66 116 L94 82 L152 142Z" fill={LILAC} /><path d="M86 92 L94 82 L102 92 L96 96 L92 92Z" fill={W} stroke-width="3" />
      <circle class="sn n1" cx="30" cy="70" r="3" fill={W} stroke-width="2" /><circle class="sn n2" cx="120" cy="90" r="3" fill={W} stroke-width="2" /><circle class="sn n3" cx="70" cy="40" r="3" fill={W} stroke-width="2" />
    </g>
  )}
  {name === 'bird' && (
    <g>
      <path d="M10 140 C30 128 50 132 60 140 M70 140 C90 126 120 130 150 140" stroke={GRASS} stroke-width="5" />
      <g class="fly">
        <path class="wing wb" d="M76 70 C70 46 54 36 40 38 C50 50 56 64 70 76Z" fill={TOM} />
        <ellipse cx="82" cy="78" rx="28" ry="18" fill={TOM} />
        <circle cx="106" cy="68" r="13" fill={TOM} />
        <path d="M118 66 L132 70 L118 74Z" fill={SUN} stroke-width="3" />
        <circle cx="108" cy="65" r="2.5" fill={INK} stroke="none" />
        <path d="M56 78 L40 72 L44 86Z" fill={TOM} stroke-width="3" />
        <path class="wing" d="M84 72 C82 46 70 30 56 28 C62 44 66 60 76 80Z" fill={SUN} />
      </g>
    </g>
  )}
  {name === 'nose' && (
    <g>
      <path class="scent s1" d="M10 50 C24 42 38 58 52 50 C62 44 70 52 76 56" stroke={GRASS} stroke-dasharray="10 12" />
      <path class="scent s2" d="M8 84 C22 76 36 92 50 84 C60 78 68 84 76 84" stroke={TOM} stroke-dasharray="10 12" />
      <path class="scent s3" d="M12 118 C26 110 40 126 54 118 C64 112 70 114 78 110" stroke={GRASS} stroke-dasharray="10 12" />
      <g class="sniff">
        <path d="M66 70 C66 48 136 48 136 70 C136 94 116 106 101 106 C86 106 66 94 66 70Z" fill="#45434a" />
        <ellipse cx="86" cy="78" rx="7" ry="5" fill={INK} stroke="none" transform="rotate(25 86 78)" />
        <ellipse cx="116" cy="78" rx="7" ry="5" fill={INK} stroke="none" transform="rotate(-25 116 78)" />
        <ellipse cx="98" cy="60" rx="14" ry="4.5" fill={W} stroke="none" opacity=".45" />
        <path d="M101 106 V122 M101 122 C93 130 82 128 78 121 M101 122 C109 130 120 128 124 121" />
      </g>
    </g>
  )}
  {name === 'duck' && (
    <g>
      <g class="bob">
        <path d="M44 96 C40 74 58 66 76 72 C78 52 98 42 112 56 C120 64 118 76 110 82 C128 82 134 96 124 108 C112 122 56 122 44 96Z" fill={SUN} />
        <path d="M112 62 L134 66 L114 72Z" fill={TOM} stroke-width="3" />
        <circle cx="100" cy="60" r="3" fill={INK} stroke="none" />
        <path d="M66 94 C76 102 92 102 102 94" />
      </g>
      <clipPath id="duck-clip"><rect x="0" y="0" width="160" height="160" /></clipPath>
      <g clip-path="url(#duck-clip)"><g class="wv"><path d="M-40 118 Q-30 110 -20 118 T0 118 T20 118 T40 118 T60 118 T80 118 T100 118 T120 118 T140 118 T160 118 T180 118 T200 118 V160 H-40Z" fill={SKY} /></g></g>
    </g>
  )}
  {name === 'bone' && (
    <g>
      <path class="spd p1" d="M14 60 H62" stroke-width="5" /><path class="spd p2" d="M24 82 H70" stroke-width="5" /><path class="spd p3" d="M8 104 H56" stroke-width="5" />
      <g class="zip"><path d="M70 74 H118 C120 64 134 62 136 72 C146 70 146 86 136 86 C134 96 120 94 118 86 H70 C68 94 54 96 52 86 C42 86 42 70 52 72 C54 62 68 64 70 74Z" fill={W} /></g>
    </g>
  )}
  {name === 'cushion' && (
    <g>
      <path class="hr h1" d="M40 46 C30 40 28 32 33 29 C36 27 39 29 40 31 C41 29 44 27 47 29 C52 32 50 40 40 46Z" fill={TOM} stroke-width="2.5" />
      <path class="hr h2" d="M122 40 C112 34 110 26 115 23 C118 21 121 23 122 25 C123 23 126 21 129 23 C134 26 132 34 122 40Z" fill={PINK} stroke-width="2.5" />
      <g class="crw"><path d="M56 64 L62 40 L74 54 L80 34 L86 54 L98 40 L104 64Z" fill={SUN} /><circle cx="80" cy="34" r="4" fill={TOM} stroke-width="2.5" /></g>
      <path d="M24 92 C24 76 40 72 80 72 C120 72 136 76 136 92 V112 C136 128 120 132 80 132 C40 132 24 128 24 112Z" fill={LILAC} />
      <path d="M24 92 L12 86 M136 92 L148 86 M24 112 L12 118 M136 112 L148 118" />
      <circle cx="80" cy="102" r="4" fill={INK} stroke="none" />
    </g>
  )}
  {name === 'plane' && (
    <g>
      <path class="trl" d="M14 132 C40 132 44 100 70 104 C92 108 86 80 104 70" stroke-dasharray="6 9" stroke-width="3" />
      <g class="pln"><path d="M150 20 L60 60 L92 72Z" fill={W} /><path d="M150 20 L92 72 L104 108Z" fill={SKY} /><path d="M92 72 L96 92 L104 108" stroke-width="3" /></g>
    </g>
  )}
  {name === 'ticket' && (
    <g>
      <path d="M80 6 V40" stroke-width="3" />
      <g class="swing">
        <path d="M54 52 L80 34 L106 52 V140 Q106 146 100 146 H60 Q54 146 54 140Z" fill={SUN} />
        <circle cx="80" cy="52" r="6" fill={W} />
        <text x="80" y="104" text-anchor="middle" font-family="Bricolage Grotesque Variable, sans-serif" font-weight="800" font-size="23" fill={INK} stroke="none">35€</text>
        <path d="M64 120 H96" stroke-width="3" stroke-dasharray="4 6" />
      </g>
    </g>
  )}
  {name === 'star' && (
    <g class="stw"><path d="M80 18 L96 58 L140 60 L106 88 L118 132 L80 108 L42 132 L54 88 L20 60 L64 58Z" fill={SUN} /><path d="M70 66 C74 60 80 58 86 60" stroke={W} stroke-width="3" /></g>
  )}
</svg>

<style>
  .il { display: block; overflow: visible; }
  .il * { transform-box: fill-box; }
  /* ball */
  .bb { animation: bounce 1.1s infinite; transform-box: view-box !important; }
  .bs { transform-origin: 50% 100%; animation: squash 1.1s infinite; }
  .sh { transform-origin: center; animation: shadow 1.1s infinite; }
  @keyframes bounce { 0%, 100% { transform: translateY(0); animation-timing-function: cubic-bezier(.5, 0, 1, .5); } 48% { transform: translateY(54px); animation-timing-function: cubic-bezier(0, .5, .5, 1); } }
  @keyframes squash { 0%, 40%, 58%, 100% { transform: scale(1); } 48% { transform: scale(1.18, .8); } }
  @keyframes shadow { 0%, 100% { transform: scale(.55); opacity: .1; } 48% { transform: scale(1); opacity: .22; } }
  /* puppy */
  .tail { transform-origin: 100% 100%; animation: wag .35s ease-in-out infinite alternate; }
  @keyframes wag { from { transform: rotate(-18deg); } to { transform: rotate(16deg); } }
  .phead { transform-origin: 30% 90%; animation: tilt 3.4s ease-in-out infinite; }
  @keyframes tilt { 0%, 60%, 100% { transform: none; } 70%, 88% { transform: rotate(-12deg); } }
  .tg { transform-origin: 50% 0; animation: pant .5s ease-in-out infinite alternate; }
  @keyframes pant { to { transform: scaleY(1.3); } }
  /* heart */
  .beat { transform-origin: center; animation: beat 1.3s infinite; }
  @keyframes beat { 0%, 40%, 100% { transform: scale(1); } 15% { transform: scale(1.12); } 28% { transform: scale(1.04); } }
  .spk { transform-origin: center; animation: twinkle 1.8s ease-in-out infinite; }
  .s2 { animation-delay: -.6s; } .s3 { animation-delay: -1.2s; }
  @keyframes twinkle { 0%, 100% { transform: scale(.4) rotate(0); opacity: .3; } 50% { transform: scale(1.1) rotate(45deg); opacity: 1; } }
  /* house */
  .smk { transform-origin: center; animation: smoke 2.4s ease-out infinite; opacity: 0; }
  .k2 { animation-delay: -.8s; } .k3 { animation-delay: -1.6s; }
  @keyframes smoke { 0% { transform: translate(0, 0) scale(.6); opacity: 0; } 20% { opacity: 1; } 100% { transform: translate(14px, -34px) scale(1.5); opacity: 0; } }
  .box { transform-origin: 50% 100%; animation: hop 1.6s ease-in-out infinite; }
  @keyframes hop { 0%, 60%, 100% { transform: none; } 70% { transform: translateY(-14px) rotate(-6deg); } 80% { transform: scale(1.08, .92); } }
  /* tree */
  .crown { transform-origin: 50% 100%; animation: sway 3s ease-in-out infinite alternate; }
  @keyframes sway { from { transform: rotate(-3deg); } to { transform: rotate(3deg); } }
  .leaf { animation: fall 3.6s ease-in infinite; opacity: 0; }
  .l2 { animation-delay: -1.2s; } .l3 { animation-delay: -2.4s; }
  @keyframes fall { 0% { transform: translate(0, 0) rotate(0); opacity: 0; } 10% { opacity: 1; } 100% { transform: translate(18px, 40px) rotate(220deg); opacity: 0; } }
  /* paws */
  .pw { animation: step 3s infinite; animation-delay: calc(var(--i) * .35s); opacity: 0; transform-box: view-box !important; }
  @keyframes step { 0% { opacity: 0; } 8%, 55% { opacity: 1; } 75%, 100% { opacity: 0; } }
  /* chat */
  .dt { animation: dot 1.2s ease-in-out infinite; }
  .d2 { animation-delay: .15s; } .d3 { animation-delay: .3s; }
  @keyframes dot { 0%, 60%, 100% { transform: none; } 30% { transform: translateY(-10px); } }
  .hrt { transform-origin: center; animation: pop 2.4s var(--spring) infinite; }
  @keyframes pop { 0%, 50% { transform: scale(0); } 65%, 90% { transform: scale(1) rotate(-10deg); } 100% { transform: scale(0); } }
  /* magnifier */
  .mg { animation: search 3.2s ease-in-out infinite; transform-box: view-box !important; }
  @keyframes search { 0%, 100% { transform: translate(-14px, 4px) rotate(-6deg); } 50% { transform: translate(14px, -4px) rotate(6deg); } }
  /* bulb */
  .rays { animation: flash 1.6s ease-in-out infinite; transform-box: view-box !important; transform-origin: 80px 70px; }
  @keyframes flash { 0%, 100% { opacity: .2; transform: scale(.9); } 50% { opacity: 1; transform: scale(1.06); } }
  .glass { animation: glow 1.6s ease-in-out infinite; }
  @keyframes glow { 50% { fill: #ffe27a; } }
  /* stairs */
  .climb { animation: climb 3s infinite; transform-box: view-box !important; }
  @keyframes climb {
    0% { transform: translate(0, 0); } 10% { transform: translate(18px, -26px); } 20% { transform: translate(36px, -28px); }
    30% { transform: translate(54px, -54px); } 40% { transform: translate(72px, -56px); } 50% { transform: translate(90px, -82px); }
    60%, 85% { transform: translate(96px, -84px); } 100% { transform: translate(96px, -84px); opacity: 0; }
  }
  .flag { transform-origin: 0 50%; animation: flag 1s ease-in-out infinite alternate; }
  @keyframes flag { to { transform: scaleX(.75) skewY(6deg); } }
  /* sprout */
  .grow { transform-origin: 50% 100%; animation: grow 4s var(--ease) infinite; }
  @keyframes grow { 0% { transform: scale(.2, 0); } 35%, 90% { transform: none; } 100% { transform: scale(.2, 0); } }
