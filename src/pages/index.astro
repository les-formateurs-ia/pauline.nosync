---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
import LIcon from '../components/LIcon.astro';
import OsloAvatar from '../components/OsloAvatar.astro';
import DogFinder from '../components/DogFinder.astro';
import ArticleCard from '../components/ArticleCard.astro';
import { programs, steps, prices } from '../data/site';
import paulineOslo from '../assets/photos/pauline-oslo.jpg';
import osloBalle from '../assets/photos/oslo-balle.jpg';
import riviere from '../assets/photos/riviere.jpg';
import frisbee from '../assets/photos/frisbee.jpg';
import osloChiot from '../assets/photos/oslo-chiot.jpg';
import osloLabrador from '../assets/photos/oslo-labrador.jpg';

const articles = (await getCollection('conseils')).sort((a, b) => a.data.order - b.data.order).slice(0, 3);
const struggles = ['Il tire en laisse', 'Il ne revient pas au rappel', 'Il aboie ou détruit quand je pars', 'Il réagit aux autres chiens', 'Il garde ses jouets ou sa gamelle', 'Il saute sur les gens', 'Je viens d’adopter un chiot'];
const progIcon = ['target', 'sprout', 'heart', 'house'];
const gallery = [
  { src: riviere, alt: 'Trois chiens au bord du Rhône', cap: 'Balade sur les quais du Rhône' },
  { src: osloChiot, alt: 'Un chiot et Oslo dans l’herbe', cap: 'Socialisation d’un chiot avec Oslo', wide: true },
  { src: frisbee, alt: 'Chienne couchée avec un frisbee', cap: 'Travail du calme en extérieur' },
  { src: osloLabrador, alt: 'Oslo et un labrador chocolat', cap: 'Rencontre entre congénères' },
  { src: paulineOslo, alt: 'Pauline et Oslo dans un parc', cap: 'Pauline et Oslo' },
];
---
<Layout>
  <!-- HERO -->
  <section class="hero" data-hero>
    <div class="w hero-grid">
      <div class="hero-txt">
        <p class="label" data-reveal>Éducatrice &amp; comportementaliste canin · Lyon 7</p>
        <h1 data-split>Un lien de <em>confiance</em>, pour avancer ensemble.</h1>
        <p class="lead" data-reveal>Réactivité, aboiements, anxiété, chiot qui découvre le monde… Je vous aide à comprendre votre chien et vous donne des outils concrets pour retrouver un quotidien serein.</p>
        <div class="btns" data-reveal>
          <a class="btn sage" href="/contact/">Prendre rendez-vous <Icon name="arrow" size={17} /></a>
          <a class="btn ghost" href="#mon-chien">Présenter mon chien</a>
        </div>
        <ul class="trust" data-reveal="stagger">
          <li><LIcon name="cap" size={20} /> Diplômée EFM · ACACED</li>
          <li><LIcon name="handheart" size={20} /> Méthodes bienveillantes</li>
          <li><LIcon name="house" size={20} /> À domicile, Lyon &amp; alentours</li>
        </ul>
      </div>
      <div class="hero-visual">
        <div class="photo hero-img" data-img>
          <Image src={paulineOslo} alt="Pauline Renard accroupie dans un parc avec son chien Oslo" widths={[400, 675]} sizes="(min-width: 1000px) 500px, 90vw" loading="eager" fetchpriority="high" />
        </div>
        <div class="price-card" data-reveal>
          <span class="pc-l">Séance bilan</span>
          <span class="pc-p">35 €</span>
          <span class="pc-s">Pour faire connaissance</span>
        </div>
      </div>
    </div>
  </section>

  <!-- DOG FINDER -->
  <section class="finder bg-stone" id="mon-chien">
    <div class="w finder-grid">
      <div>
        <p class="label"><span class="n">01</span> Le guide d’Oslo</p>
        <h2 data-split>Chaque chien a son <em>histoire</em>.</h2>
        <p class="muted" data-reveal>Bergers, terriers, primitifs, chiens de chasse… La famille de race de votre chien explique beaucoup de ses comportements. Présentez-le, je vous explique comment il fonctionne et comment adapter son éducation.</p>
        <div class="oslo-line" data-reveal><OsloAvatar size={48} /><span>Le guide est présenté par <strong>Oslo</strong>, mon bouvier de l’Entlebuch.</span></div>
      </div>
      <div class="finder-card" data-reveal>
        <DogFinder />
        <a class="link small" href="/races/">Voir les 9 familles de races <Icon name="arrow" size={15} /></a>
      </div>
    </div>
  </section>

  <!-- STRUGGLES -->
  <section>
    <div class="w split">
      <div class="split-l">
        <p class="label"><span class="n">02</span> Vous vous reconnaissez ?</p>
        <h2 data-split>Chaque difficulté a <em>sa solution</em>.</h2>
        <p class="muted" data-reveal>Derrière chaque comportement gênant, il y a une émotion, un besoin ou un apprentissage. On le comprend ensemble, puis on avance pas à pas.</p>
        <a class="link" href="/accompagnements/" data-reveal>Découvrir mes accompagnements <Icon name="arrow" size={15} /></a>
      </div>
      <ul class="quotes" data-reveal="stagger">
        {struggles.map((s, i) => <li><span class="qi">{String(i + 1).padStart(2, '0')}</span><span class="qt">« {s} »</span><Icon name="arrow" size={18} /></li>)}
      </ul>
    </div>
  </section>

  <!-- PROGRAMS -->
  <section class="bg-stone">
    <div class="w">
      <div class="row-head">
        <div><p class="label"><span class="n">03</span> Accompagnements</p><h2 data-split>Un accompagnement adapté à chaque chien.</h2></div>
        <a class="btn ghost" href="/accompagnements/">Tout découvrir <Icon name="arrow" size={17} /></a>
      </div>
      <div class="grid g4" data-reveal="stagger">
        {programs.map((p, i) => (
          <a class="card hover prog" href={`/accompagnements/#${p.slug}`}>
            <span class="icon-c"><LIcon name={progIcon[i]} /></span>
            <h3>{p.title}</h3>
            <p>{p.lead}</p>
            <span class="more">En savoir plus <Icon name="arrow" size={15} /></span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- METHOD -->
  <section>
    <div class="w method">
      <div class="method-l">
        <p class="label"><span class="n">04</span> Ma méthode</p>
        <h2 data-split>Comprendre <em>avant</em> d’éduquer.</h2>
        <div class="photo method-img" data-img><Image src={osloChiot} alt="Un chiot et Oslo couchés dans l’herbe" widths={[400, 675]} sizes="(min-width: 900px) 480px, 90vw" /></div>
      </div>
      <div class="trail" data-trail>
        <svg class="trail-svg" viewBox="0 0 2 100" preserveAspectRatio="none" aria-hidden="true">
          <path class="trail-bg" d="M1 0 L1 100" /><path data-trail-path class="trail-fg" d="M1 0 L1 100" />
        </svg>
        <div class="trail-dog" data-trail-dog aria-hidden="true"><OsloAvatar size={40} /></div>
        {steps.map((s) => (
          <div class="step" data-reveal>
            <span class="sn">{s.n}</span>
            <div><h3>{s.title}</h3><p>{s.text}</p></div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- OSLO -->
  <section class="bg-sage">
    <div class="w oslo-grid">
      <div class="oslo-photos">
        <div class="photo op1" data-img><Image src={osloBalle} alt="Oslo, bouvier de l’Entlebuch, avec sa balle" widths={[400, 675]} sizes="(min-width: 900px) 380px, 70vw" /></div>
        <div class="photo op2" data-parallax="0.08"><Image src={osloLabrador} alt="Oslo assis à côté d’un labrador" widths={[300, 500]} sizes="240px" /></div>
      </div>
      <div>
        <p class="label"><span class="n">05</span> Mon binôme</p>
        <h2 data-split>Oslo, <em>chien régulateur</em>.</h2>
        <p class="lead" data-reveal>Selon les situations, Oslo participe aux séances : un partenaire idéal pour aider les chiens à apprendre les bons codes et à se sentir en confiance face à leurs congénères.</p>
        <dl class="facts" data-reveal="stagger">
          <div><dt>Race</dt><dd>Bouvier de l’Entlebuch</dd></div>
          <div><dt>Âge</dt><dd><span data-count="8">8</span> ans</dd></div>
          <div><dt>Tempérament</dt><dd>Très calme, très bien codé</dd></div>
          <div><dt>Rôle</dt><dd>Aider les chiens à reprendre confiance</dd></div>
        </dl>
      </div>
    </div>
  </section>

  <!-- PRICES -->
  <section>
    <div class="w">
      <div class="head center"><p class="label"><span class="n">06</span> Tarifs</p><h2 data-split>Des tarifs <em>simples</em> et transparents.</h2></div>
      <div class="prices" data-reveal="stagger">
        {prices.map((p) => (
          <a class:list={['pcard', { featured: p.featured }]} href="/offres/">
            {p.featured && <span class="badge">Le plus choisi</span>}
            <span class="pn">{p.name}</span>
            <span class="pp">{p.price} €</span>
            <span class="pu">{p.unit}</span>
          </a>
        ))}
      </div>
      <p class="center more-p"><a class="link" href="/offres/">Détail des offres et des formats <Icon name="arrow" size={15} /></a></p>
    </div>
  </section>

  <!-- GALLERY -->
  <section class="gal bg-stone">
    <div class="w"><p class="label"><span class="n">07</span> Sur le terrain</p><h2 data-split>Au fil des <em>balades</em>, à Lyon.</h2></div>
    <div class="strip-wrap">
      <div class="strip" data-hscroll>
        {gallery.map((g) => (
          <figure class:list={['shot', { wide: g.wide }]}>
            <div class="photo"><Image src={g.src} alt={g.alt} widths={[400, 675]} sizes="420px" loading="lazy" /></div>
            <figcaption class="caption">{g.cap}</figcaption>
          </figure>
        ))}
      </div>
    </div>
  </section>

  <!-- ARTICLES -->
  <section>
    <div class="w">
      <div class="row-head">
        <div><p class="label"><span class="n">08</span> Conseils</p><h2 data-split>Conseils pour le quotidien.</h2></div>
        <a class="btn ghost" href="/conseils/">Tous les conseils <Icon name="arrow" size={17} /></a>
      </div>
      <div class="grid g3" data-reveal="stagger">{articles.map((a) => <ArticleCard entry={a} />)}</div>
    </div>
  </section>
</Layout>

<style>
  .hero { padding: clamp(40px, 6vw, 80px) 0 clamp(70px, 9vw, 120px); }
  .hero-grid { display: grid; gap: 56px; align-items: center; }
  @media (min-width: 1000px) { .hero-grid { grid-template-columns: 1.15fr .85fr; gap: 80px; } }
  .hero h1 { font-size: clamp(2.8rem, 6.4vw, 5.6rem); margin-bottom: 28px; }
  .hero .lead { margin-bottom: 34px; }
  .trust { list-style: none; padding: 0; margin: 44px 0 0; display: flex; flex-wrap: wrap; gap: 14px 30px; font-size: .92rem; color: var(--ink2); padding-top: 26px; border-top: 1px solid var(--line); }
  .trust li { display: inline-flex; align-items: center; gap: 10px; }
  .trust :global(svg) { color: var(--sage); }
  .hero-visual { position: relative; }
  .hero-img { aspect-ratio: 4 / 5; border-radius: 200px 200px var(--r) var(--r); }
  .price-card { position: absolute; left: -28px; bottom: 36px; display: grid; gap: 2px; background: var(--white); border: 1px solid var(--line); border-radius: var(--r); padding: 18px 22px; box-shadow: var(--shadow); }
  .pc-l { font-size: .75rem; font-weight: 600; letter-spacing: .12em; text-transform: uppercase; color: var(--sage); }
  .pc-p { font-family: var(--display); font-weight: 500; font-size: 2.2rem; letter-spacing: -.03em; line-height: 1.1; }
  .pc-s { font-size: .85rem; color: var(--ink3); }
  @media (max-width: 600px) { .price-card { left: 12px; bottom: 12px; } }

  .finder-grid { display: grid; gap: 48px; align-items: center; }
  @media (min-width: 1000px) { .finder-grid { grid-template-columns: .85fr 1.15fr; gap: 72px; } }
  .oslo-line { display: flex; align-items: center; gap: 14px; margin-top: 26px; font-size: .95rem; color: var(--ink2); }
  .finder-card { background: var(--white); border: 1px solid var(--line); border-radius: var(--r-lg); padding: clamp(28px, 4vw, 48px); display: grid; gap: 22px; }
  .small { font-size: .9rem; justify-self: start; }

  .split { display: grid; gap: 48px; }
  @media (min-width: 960px) { .split { grid-template-columns: .9fr 1.1fr; gap: 80px; } .split-l { position: sticky; top: 120px; align-self: start; } }
  .split-l .muted { margin-bottom: 26px; max-width: 46ch; }
  .quotes { list-style: none; padding: 0; margin: 0; border-top: 1px solid var(--line); }
  .quotes li { display: flex; align-items: center; gap: 22px; padding: 24px 4px; border-bottom: 1px solid var(--line); transition: padding .4s var(--ease), color .3s; }
  .quotes li:hover { padding-left: 14px; color: var(--sage); }
  .qi { font-family: var(--serif); font-style: italic; color: var(--ink3); font-size: 1.1rem; width: 28px; }
  .qt { flex: 1; font-family: var(--display); font-size: clamp(1.2rem, 2vw, 1.6rem); letter-spacing: -.02em; }
  .quotes :global(svg) { opacity: 0; transform: translateX(-8px); transition: opacity .3s, transform .4s var(--ease); }
  .quotes li:hover :global(svg) { opacity: 1; transform: none; }

  .prog { display: flex; flex-direction: column; text-decoration: none; }
  .prog h3 { margin: 22px 0 10px; }
  .prog p { color: var(--ink2); font-size: .96rem; flex: 1; }
  .more { display: inline-flex; align-items: center; gap: 8px; font-size: .9rem; font-weight: 500; color: var(--sage); }

  .method { display: grid; gap: 56px; }
  @media (min-width: 960px) { .method { grid-template-columns: 1fr 1fr; gap: 90px; } .method-l { position: sticky; top: 120px; align-self: start; } }
  .method-img { aspect-ratio: 4 / 3; margin-top: 18px; }
  .trail { position: relative; display: grid; gap: 18px; padding: 10px 0 10px 64px; }
  .trail-svg { position: absolute; left: 0; top: 0; width: 40px; height: 100%; overflow: visible; }
  .trail-bg { fill: none; stroke: var(--line); stroke-width: 1.5; vector-effect: non-scaling-stroke; }
  .trail-fg { fill: none; stroke: var(--sage); stroke-width: 1.5; vector-effect: non-scaling-stroke; }
  .trail-dog { position: absolute; left: 0; top: 0; z-index: 2; border-radius: 50%; box-shadow: 0 0 0 5px var(--paper); }
  .step { display: flex; gap: 22px; padding: 30px 0; border-bottom: 1px solid var(--line); }
  .step:last-child { border-bottom: 0; }
  .sn { font-family: var(--serif); font-style: italic; font-size: 2.2rem; line-height: 1; color: var(--sage); width: 48px; flex: none; }
  .step h3 { margin-bottom: 8px; }
  .step p { margin: 0; color: var(--ink2); }

  .oslo-grid { display: grid; gap: 64px; align-items: center; }
  @media (min-width: 960px) { .oslo-grid { grid-template-columns: .9fr 1.1fr; gap: 90px; } }
  .oslo-photos { position: relative; padding: 0 70px 70px 0; }
  .op1 { aspect-ratio: 4 / 5; }
  .op2 { position: absolute; right: 0; bottom: 0; width: 46%; aspect-ratio: 3 / 4; border: 6px solid var(--sage-l); }
  .facts { margin: 34px 0 0; border-top: 1px solid rgb(54 81 63 / .2); }
  .facts div { display: grid; grid-template-columns: 140px 1fr; gap: 16px; padding: 14px 0; border-bottom: 1px solid rgb(54 81 63 / .2); }
  dt { font-size: .78rem; font-weight: 600; letter-spacing: .12em; text-transform: uppercase; color: var(--sage); padding-top: 3px; }
  dd { margin: 0; font-weight: 500; }

  .prices { display: grid; gap: 18px; }
  @media (min-width: 640px) { .prices { grid-template-columns: 1fr 1fr; } }
  @media (min-width: 1100px) { .prices { grid-template-columns: repeat(4, 1fr); } }
  .pcard { position: relative; display: grid; gap: 6px; padding: 32px 28px; background: var(--white); border: 1px solid var(--line); border-radius: var(--r-lg); text-decoration: none; transition: border-color .3s, transform .4s var(--ease), box-shadow .4s; }
  .pcard:hover { transform: translateY(-3px); box-shadow: var(--shadow); }
  .pcard.featured { border-color: var(--sage); box-shadow: inset 0 0 0 1px var(--sage); }
  .badge { position: absolute; top: 18px; right: 18px; font-size: .72rem; font-weight: 600; letter-spacing: .08em; text-transform: uppercase; color: var(--sage-d); background: var(--sage-l); padding: 5px 10px; border-radius: 999px; }
  .pn { font-weight: 500; color: var(--ink2); }
  .pp { font-family: var(--display); font-weight: 400; font-size: 3.2rem; letter-spacing: -.04em; line-height: 1.1; }
  .pu { font-size: .9rem; color: var(--ink3); }
  .more-p { margin-top: 40px; }

  .gal { overflow: hidden; }
  .strip-wrap { margin-top: 44px; }
  .strip { display: flex; gap: 24px; width: max-content; align-items: flex-start; }
  .shot { margin: 0; width: clamp(240px, 24vw, 320px); }
  .shot .photo { aspect-ratio: 3 / 4; }
  .shot.wide { width: clamp(320px, 34vw, 460px); }
  .shot.wide .photo { aspect-ratio: 4 / 3; }
  @media (prefers-reduced-motion: reduce) { .strip { width: auto; flex-wrap: wrap; padding: 0 28px; } }
</style>
