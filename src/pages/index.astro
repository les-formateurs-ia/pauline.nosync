---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
import Illus from '../components/Illus.astro';
import Mark from '../components/Mark.astro';
import Kicker from '../components/Kicker.astro';
import Marquee from '../components/Marquee.astro';
import OsloAvatar from '../components/OsloAvatar.astro';
import OsloRun from '../components/OsloRun.astro';
import DogFinder from '../components/DogFinder.astro';
import ArticleCard from '../components/ArticleCard.astro';
import { programs, steps, prices } from '../data/site';
import paulineOslo from '../assets/photos/pauline-oslo.jpg';
import osloBalle from '../assets/photos/oslo-balle.jpg';
import riviere from '../assets/photos/riviere.jpg';
import frisbee from '../assets/photos/frisbee.jpg';
import osloChiot from '../assets/photos/oslo-chiot.jpg';
import osloLabrador from '../assets/photos/oslo-labrador.jpg';

const articles = (await getCollection('conseils')).sort((a, b) => a.data.order - b.data.order).slice(0, 3);
const struggles = [
  { t: 'Il tire en laisse', c: 'sun', x: 4, y: 8 }, { t: 'Il ne revient pas au rappel', c: 'sky', x: 62, y: 4 },
  { t: 'Il aboie quand je pars', c: 'pink', x: 0, y: 40 }, { t: 'Il réagit aux autres chiens', c: 'mint', x: 66, y: 34 },
  { t: 'Il détruit tout', c: 'lilac', x: 10, y: 72 }, { t: 'Il saute sur les gens', c: 'sun', x: 70, y: 66 },
  { t: 'Il garde ses jouets', c: 'tomato', x: 26, y: 90 }, { t: 'Je viens d’adopter un chiot', c: 'sky', x: 52, y: 90 },
];
const progIllus = ['ball', 'puppy', 'heart', 'house'];
const progColor = ['sun', 'sky', 'pink', 'mint'];
const stepIllus = ['magnifier', 'bulb', 'stairs', 'sprout'];
const tagColor = ['white', 'sky', 'sun', 'pink'];
const gallery = [
  { src: riviere, alt: 'Trois chiens au bord du Rhône', cap: 'Pause baignade sur les quais', ar: '3/4' },
  { src: osloChiot, alt: 'Un chiot et Oslo dans l’herbe', cap: 'Leçon de politesse', ar: '4/3' },
  { src: frisbee, alt: 'Chienne couchée avec un frisbee rouge', cap: 'Frisbee & patience', ar: '3/4' },
  { src: osloLabrador, alt: 'Oslo et un labrador chocolat', cap: 'Oslo & son copain', ar: '3/4' },
  { src: paulineOslo, alt: 'Pauline et Oslo dans un parc', cap: 'Pauline & Oslo', ar: '3/4' },
  { src: osloBalle, alt: 'Oslo avec sa balle orange', cap: 'LA balle orange', ar: '3/4' },
];
---
<Layout>
  <!-- ═══════════ HERO ═══════════ -->
  <section class="hero" data-hero>
    <div class="w hero-grid">
      <div class="hero-txt">
        <Kicker>Éducatrice &amp; comportementaliste canin · Lyon 7</Kicker>
        <h1 class="h1">
          <span class="ln"><span>Un lien de</span></span>
          <span class="ln"><span><Mark>confiance</Mark></span></span>
          <span class="ln"><span>pour avancer</span></span>
          <span class="ln"><span>ensemble.</span></span>
        </h1>
        <p class="lead in-up" style="--dl:.7s">Réactivité, aboiements, anxiété, chiot qui découvre le monde… Je vous aide à <strong>comprendre</strong> votre chien et vous donne des outils concrets pour un quotidien serein.</p>
        <div class="btns in-up" style="--dl:.85s">
          <a class="btn tomato" href="#mon-chien">Présenter mon chien <Icon name="arrow" size={18} /></a>
          <a class="btn white" href="/offres/">Voir les offres</a>
        </div>
      </div>

      <div class="collage" aria-label="Pauline et son chien Oslo">
        <figure class="polaroid tape p-main drop" style="--ar:4/5;--dl:.3s">
          <Image src={paulineOslo} alt="Pauline Renard accroupie dans un parc avec Oslo" widths={[400, 675]} sizes="(min-width: 1000px) 420px, 80vw" loading="eager" fetchpriority="high" />
          <figcaption>Pauline &amp; Oslo ♥</figcaption>
        </figure>
        <div class="sticker-photo drop" style="--dl:.55s">
          <Image src={osloBalle} alt="Oslo et sa balle orange" widths={[240, 400]} sizes="190px" loading="eager" />
        </div>
        <div class="badge drop" style="--dl:.75s" aria-hidden="true">
          <svg viewBox="0 0 200 200" class="spin-slow">
            <defs><path id="circ" d="M100 100 m-74 0 a74 74 0 1 1 148 0 a74 74 0 1 1 -148 0" /></defs>
            <text><textPath href="#circ">SÉANCE BILAN · 35 € · À DOMICILE · LYON ·</textPath></text>
          </svg>
          <span class="badge-c"><svg viewBox="0 0 24 24" width="38" height="38"><use href="#paw-sym" /></svg></span>
        </div>
        <div class="note-oslo drop" style="--dl:1s" aria-hidden="true">
          <span class="hand">c’est moi, Oslo !</span>
          <svg viewBox="0 0 90 60" fill="none" stroke="#17150f" stroke-width="3" stroke-linecap="round" data-draw="1.1"><path d="M6 8 C 30 6, 60 18, 70 48" /><path d="M58 40 L70 50 L78 36" /></svg>
        </div>
        <div class="ball-deco" aria-hidden="true"><Illus name="ball" size={110} /></div>
        <div class="star-deco float" aria-hidden="true"><Illus name="star" size={64} /></div>
      </div>
    </div>
  </section>

  <!-- ═══════════ DOG FINDER ═══════════ -->
  <section class="finder bg-mint" id="mon-chien">
    <svg class="wave top" viewBox="0 0 1440 40" preserveAspectRatio="none" aria-hidden="true"><path d="M0 0 V20 C 120 40, 240 40, 360 20 S 600 0, 720 20 S 960 40, 1080 20 S 1320 0, 1440 20 V0Z" /></svg>
    <div class="w finder-grid">
      <div class="finder-oslo oslo-host" data-pop>
        <OsloAvatar size={230} />
        <div class="speech hand">Wouf ! Présentez-moi votre chien, je vous explique comment il fonctionne.</div>
      </div>
      <div>
        <Kicker>Le guide d’Oslo</Kicker>
        <DogFinder />
        <p class="finder-note">Bergers, terriers, primitifs, chiens de chasse… chaque famille de races a son histoire. <a class="link" href="/races/">Voir les 9 familles</a></p>
      </div>
    </div>
  </section>

  <Marquee items={['Éducation de base', 'Chiots', 'Réactivité', 'Rappel', 'Marche en laisse']} alt={['Anxiété de séparation', 'Confiance', 'Bienveillance', 'Lyon & alentours']} />

  <!-- ═══════════ STRUGGLES ═══════════ -->
  <section class="strug">
    <div class="w">
      <div class="center">
        <Kicker>Vous vous reconnaissez ?</Kicker>
        <h2 data-split>Chaque difficulté a sa solution.</h2>
      </div>
      <div class="cloud">
        <div class="cloud-oslo oslo-host" data-pop>
          <span class="qm q1 hand">?</span><span class="qm q2 hand">?</span><span class="qm q3 hand">!</span>
          <OsloAvatar size={200} mood="calm" />
        </div>
        {struggles.map((s, i) => (
          <span class="sb" style={`--x:${s.x}%;--y:${s.y}%;--c:var(--${s.c});--r:${i % 2 ? 3 : -3}deg`} data-pop={`${i * 0.07}`}>« {s.t} »</span>
        ))}
      </div>
      <p class="lead center cl-lead" data-reveal>Derrière chaque comportement gênant, il y a une émotion, un besoin ou un apprentissage. On le comprend ensemble, puis on avance <strong>pas à pas</strong>.</p>
    </div>
  </section>

  <!-- ═══════════ PROGRAMS ═══════════ -->
  <section class="progs bg-sand">
    <div class="w">
      <div class="row-head">
        <div><Kicker>Mes accompagnements</Kicker><h2 data-split>Pour chaque chien, un chemin adapté.</h2></div>
        <a class="btn white" href="/accompagnements/">Tout découvrir <Icon name="arrow" size={18} /></a>
      </div>
      <div class="grid g4" data-reveal="stagger">
        {programs.map((p, i) => (
          <a class="prog card lift" href={`/accompagnements/#${p.slug}`} style={`--c:var(--${progColor[i]})`}>
            <div class="prog-art"><Illus name={progIllus[i]} size={150} /></div>
            <h3>{p.title}</h3>
            <p>{p.lead}</p>
            <span class="go-arr"><Icon name="arrow" size={20} /></span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- ═══════════ METHOD (scroll trail) ═══════════ -->
  <section class="method">
    <div class="w">
      <div class="center head-m"><Kicker>Ma méthode</Kicker><h2 data-split>Comprendre avant d’éduquer.</h2></div>
      <div class="trail" data-trail>
        <svg class="trail-svg" viewBox="0 0 200 1000" preserveAspectRatio="none" aria-hidden="true">
          <path class="trail-bg" d="M100 0 C 180 120, 20 250, 100 375 S 180 620, 100 750 S 20 900, 100 1000" />
          <path data-trail-path class="trail-fg" d="M100 0 C 180 120, 20 250, 100 375 S 180 620, 100 750 S 20 900, 100 1000" />
        </svg>
        <div class="trail-dog" data-trail-dog aria-hidden="true"><OsloAvatar size={74} /></div>
        {steps.map((s, i) => (
          <div class:list={['step', i % 2 ? 'r' : 'l']} data-step={i % 2 ? 'r' : 'l'}>
            <div class="step-art"><Illus name={stepIllus[i]} size={120} /></div>
            <div class="step-txt">
              <span class="num outline-text">{s.n}</span>
              <h3>{s.title}</h3>
              <p>{s.text}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ═══════════ OSLO ID CARD ═══════════ -->
  <section class="oslo bg-sky">
    <svg class="wave top" viewBox="0 0 1440 40" preserveAspectRatio="none" aria-hidden="true"><path d="M0 0 V20 C 120 40, 240 40, 360 20 S 600 0, 720 20 S 960 40, 1080 20 S 1320 0, 1440 20 V0Z" /></svg>
    <div class="w oslo-grid">
      <div class="pile">
        <figure class="polaroid tape pink pl1" style="--ar:3/4" data-parallax="0.08"><Image src={osloBalle} alt="Oslo et sa balle" widths={[400, 675]} sizes="(min-width: 900px) 360px, 70vw" /><figcaption>8 ans de sagesse</figcaption></figure>
        <figure class="polaroid tape sky pl2" style="--ar:3/4" data-parallax="-0.06"><Image src={osloLabrador} alt="Oslo et un labrador" widths={[300, 500]} sizes="240px" /><figcaption>avec un copain</figcaption></figure>
      </div>
      <div>
        <Kicker>Mon binôme</Kicker>
        <h2 data-split>Oslo, chien régulateur.</h2>
        <div class="idcard" data-reveal>
          <div class="id-top"><span>Carte de chien régulateur</span><span class="hand">n° 001</span></div>
          <div class="id-body">
            <OsloAvatar size={110} />
            <dl>
              <div><dt>Nom</dt><dd>Oslo</dd></div>
              <div><dt>Race</dt><dd>Bouvier de l’Entlebuch</dd></div>
              <div><dt>Âge</dt><dd><span data-count="8">8</span> ans</dd></div>
              <div><dt>Qualités</dt><dd>Très calme, très bien codé</dd></div>
            </dl>
          </div>
          <p class="id-stamp hand">Validé par Pauline ✓</p>
        </div>
        <p class="lead" data-reveal>Selon les situations, Oslo peut participer aux séances : un partenaire idéal pour aider les chiens à apprendre les bons codes et à se sentir en confiance face à leurs congénères.</p>
      </div>
    </div>
    <div class="oslo-run" aria-hidden="true"><OsloRun size={170} /></div>
  </section>

  <!-- ═══════════ PRICES ═══════════ -->
  <section class="prices">
    <div class="w">
      <div class="center"><Kicker>Tarifs</Kicker><h2 data-split>Simple et transparent.</h2></div>
      <div class="tags" data-reveal="stagger">
        {prices.map((p, i) => (
          <a class="tag" href="/offres/" style={`--c:var(--${tagColor[i]});--sw:${i * -0.6}s`}>
            <span class="hole"></span>
            {p.featured && <span class="fav hand">le + choisi !</span>}
            <span class="tname">{p.name}</span>
            <span class="tprice">{p.price}<small>€</small></span>
            <span class="tunit">{p.unit}</span>
          </a>
        ))}
      </div>
      <p class="center"><a class="btn" href="/offres/">Détail des offres et formats <Icon name="arrow" size={18} /></a></p>
    </div>
  </section>

  <!-- ═══════════ GALLERY (horizontal on scroll) ═══════════ -->
  <section class="gal bg-sand">
    <div class="w"><Kicker>Au fil des balades</Kicker><h2 data-split>Sur le terrain, à Lyon.</h2></div>
    <div class="strip-wrap">
      <div class="strip" data-hscroll>
        {gallery.map((g, i) => (
          <figure class="polaroid" style={`--ar:${g.ar};--r:${[-3, 2, -1.5, 3, -2.5, 1.5][i]}deg`}>
            <Image src={g.src} alt={g.alt} widths={[400, 675]} sizes="340px" loading="lazy" />
            <figcaption>{g.cap}</figcaption>
          </figure>
        ))}
      </div>
    </div>
  </section>

  <!-- ═══════════ ARTICLES ═══════════ -->
  <section>
    <div class="w">
      <div class="row-head">
        <div><Kicker>Conseils</Kicker><h2 data-split>Mes conseils pour le quotidien.</h2></div>
        <a class="btn white" href="/conseils/">Tous les conseils <Icon name="arrow" size={18} /></a>
      </div>
      <div class="grid g3" data-reveal="stagger">{articles.map((a, i) => <ArticleCard entry={a} i={i} />)}</div>
    </div>
  </section>
</Layout>

<style>
  /* HERO */
  .hero { padding: clamp(24px, 4vw, 56px) 0 clamp(60px, 8vw, 110px); overflow: hidden; }
  .hero-grid { display: grid; gap: 48px; align-items: center; }
  @media (min-width: 1000px) { .hero-grid { grid-template-columns: 1.1fr .9fr; } }
  .h1 { font-size: clamp(3.3rem, 8.6vw, 7.6rem); margin: 6px 0 26px; line-height: .92; }
  .ln { display: block; overflow: hidden; padding-bottom: .06em; margin-bottom: -.06em; }
  .ln > span { display: inline-block; animation: rise 1s var(--ease) both; }
  .ln:nth-child(2) > span { animation-delay: .1s; } .ln:nth-child(3) > span { animation-delay: .2s; } .ln:nth-child(4) > span { animation-delay: .3s; }
  .ln:nth-child(2) { overflow: visible; }
  @keyframes rise { from { transform: translateY(110%) rotate(4deg); } }
  .in-up { animation: inup .9s var(--ease) both; animation-delay: var(--dl); }
  @keyframes inup { from { opacity: 0; transform: translateY(24px); } }
  .lead strong { color: var(--ink); }

  .collage { position: relative; height: clamp(440px, 52vw, 600px); max-width: 560px; width: 100%; margin: 0 auto; }
  .drop { animation: drop 1s var(--spring) both; animation-delay: var(--dl); }
  @keyframes drop { from { opacity: 0; transform: translateY(-80px) rotate(-12deg) scale(.9); } }
  .p-main { position: absolute; top: 2%; right: 4%; width: 68%; rotate: 4deg; margin: 0; }
  .sticker-photo { position: absolute; left: 0; bottom: 6%; width: 40%; aspect-ratio: 1; border-radius: 50%; overflow: hidden; border: var(--line); box-shadow: var(--hard); rotate: -6deg; }
  .sticker-photo img { width: 100%; height: 100%; object-fit: cover; }
  .badge { position: absolute; right: -2%; bottom: 0; width: 34%; aspect-ratio: 1; border-radius: 50%; background: var(--sun); border: var(--line); box-shadow: var(--hard); }
  .badge svg.spin-slow { width: 100%; height: 100%; }
  .badge text { font-family: var(--display); font-weight: 800; font-size: 19px; letter-spacing: 2px; fill: var(--ink); }
  .badge-c { position: absolute; inset: 0; display: grid; place-items: center; color: var(--tomato); }
  .note-oslo { position: absolute; left: 4%; top: 30%; display: flex; flex-direction: column; align-items: flex-start; rotate: -8deg; }
  .note-oslo .hand { font-size: 1.6rem; color: var(--tomato); }
  .note-oslo svg { width: 90px; height: 60px; margin-left: 30px; }
  .ball-deco { position: absolute; top: -4%; left: 10%; }
  .star-deco { position: absolute; right: 0; top: -2%; }
  @media (max-width: 600px) { .ball-deco { left: 0; top: 0; } .ball-deco :global(svg) { width: 80px; height: 80px; } .note-oslo { top: 20%; } }

  /* FINDER */
  .finder { padding-top: clamp(90px, 10vw, 130px); }
  .wave.top { position: absolute; top: -1px; left: 0; right: 0; color: var(--paper); }
  .finder-grid { display: grid; gap: 40px; align-items: center; }
  @media (min-width: 980px) { .finder-grid { grid-template-columns: .55fr 1.45fr; } }
  .finder-oslo { display: grid; justify-items: center; gap: 18px; }
  .speech { position: relative; background: var(--white); border: var(--line); border-radius: 22px; padding: 14px 18px; font-size: 1.35rem; line-height: 1.2; text-align: center; max-width: 280px; box-shadow: var(--hard); }
  .speech::before { content: ''; position: absolute; top: -12px; left: 50%; width: 20px; height: 20px; background: var(--white); border-left: var(--line); border-top: var(--line); transform: translateX(-50%) rotate(45deg); }
  .finder-note { margin: 22px 0 0; font-size: 1.02rem; }
  @media (max-width: 979px) { .finder-oslo :global(.oslo) { width: 150px; height: 150px; } }

  /* STRUGGLES */
  .strug { padding-top: clamp(40px, 6vw, 80px); }
  .cloud { position: relative; margin: 40px auto 20px; display: flex; flex-wrap: wrap; justify-content: center; gap: 12px; }
  .cloud-oslo { position: relative; display: grid; place-items: center; width: 100%; margin-bottom: 16px; }
  .qm { position: absolute; font-size: 3rem; color: var(--tomato); animation: qm 2.4s ease-in-out infinite; }
  .q1 { left: calc(50% - 130px); top: 0; } .q2 { left: calc(50% + 100px); top: 10px; animation-delay: -.8s; color: var(--grass); } .q3 { left: calc(50% + 70px); top: -40px; animation-delay: -1.6s; }
  @keyframes qm { 0%, 100% { transform: translateY(0) rotate(-10deg); opacity: .4; } 50% { transform: translateY(-14px) rotate(10deg); opacity: 1; } }
  .sb { display: inline-block; background: var(--c); border: var(--line); border-radius: 999px; padding: 12px 22px; font-family: var(--hand); font-size: clamp(1.2rem, 2vw, 1.55rem); line-height: 1.1; box-shadow: 4px 4px 0 var(--ink); rotate: var(--r); transition: rotate .4s var(--spring), scale .4s var(--spring); cursor: default; }
  .sb:hover { rotate: calc(var(--r) * -2); scale: 1.08; }
  @media (min-width: 1000px) {
    .cloud { display: block; height: 560px; max-width: 1060px; }
    .cloud-oslo { position: absolute; left: 50%; top: 48%; width: auto; transform: translate(-50%, -50%); margin: 0; }
    .sb { position: absolute; left: var(--x); top: var(--y); }
  }
  .cl-lead { margin: 30px auto 0; }

  /* PROGRAMS */
  .row-head { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: flex-end; gap: 20px; margin-bottom: clamp(36px, 5vw, 60px); }
  .row-head h2 { margin: 0; max-width: 14ch; }
  .prog { position: relative; display: flex; flex-direction: column; text-decoration: none; padding: 0; overflow: hidden; }
  .prog-art { display: grid; place-items: center; background: var(--c); border-bottom: var(--line); padding: 18px 0 12px; }
  .prog h3 { padding: 22px 22px 0; }
  .prog p { padding: 0 22px; color: var(--ink2); flex: 1; font-size: .98rem; }
  .go-arr { align-self: flex-end; display: grid; place-items: center; width: 46px; height: 46px; margin: 0 18px 18px; border: var(--line); border-radius: 50%; background: var(--c); transition: transform .45s var(--spring); }
  .prog:hover .go-arr { transform: rotate(-35deg) scale(1.1); }

  /* METHOD TRAIL */
  .head-m { margin-bottom: 40px; }
  .trail { position: relative; display: grid; gap: clamp(40px, 7vw, 110px); padding: 40px 0; }
  .trail-svg { position: absolute; left: 50%; top: 0; width: 200px; height: 100%; transform: translateX(-50%); overflow: visible; }
  .trail-bg { fill: none; stroke: var(--ink); stroke-opacity: .2; stroke-width: 4; stroke-dasharray: 2 14; vector-effect: non-scaling-stroke; }
  .trail-fg { fill: none; stroke: var(--tomato); stroke-width: 6; stroke-linecap: round; vector-effect: non-scaling-stroke; }
  .trail-dog { position: absolute; left: 0; top: 0; z-index: 3; filter: drop-shadow(3px 3px 0 var(--ink)); }
  .step { position: relative; z-index: 2; display: flex; align-items: center; gap: 24px; width: calc(50% - 90px); background: var(--white); border: var(--line); border-radius: 28px; padding: 24px; box-shadow: var(--hard); }
  .step.r { justify-self: end; }
  .step-art { flex: none; display: grid; place-items: center; width: 130px; height: 130px; border-radius: 50%; background: var(--sand); border: var(--line); }
  .num { display: block; font-family: var(--display); font-weight: 800; font-size: 3.2rem; line-height: .9; margin-bottom: 6px; }
  .step-txt p { margin: 0; color: var(--ink2); }
  @media (max-width: 899px) {
    .trail-svg { left: 24px; width: 48px; transform: none; }
    .step { width: auto; margin-left: 70px; flex-direction: column; align-items: flex-start; }
    .step.r { justify-self: stretch; }
    .step-art { width: 100px; height: 100px; } .step-art :global(svg) { width: 90px; height: 90px; }
  }

  /* OSLO */
  .oslo { padding-top: clamp(100px, 12vw, 160px); padding-bottom: clamp(160px, 15vw, 210px); overflow: hidden; }
  .oslo-grid { display: grid; gap: 56px; align-items: center; }
  @media (min-width: 900px) { .oslo-grid { grid-template-columns: .9fr 1.1fr; } }
  .pile { position: relative; height: clamp(420px, 46vw, 560px); }
  .pl1 { position: absolute; left: 0; top: 0; width: 66%; rotate: -5deg; margin: 0; }
  .pl2 { position: absolute; right: 0; bottom: 0; width: 50%; rotate: 6deg; margin: 0; }
  .idcard { position: relative; background: var(--white); border: var(--line); border-radius: 22px; overflow: hidden; box-shadow: var(--hard-lg); margin: 10px 0 30px; max-width: 520px; rotate: -1deg; }
  .id-top { display: flex; justify-content: space-between; align-items: center; background: var(--tomato); border-bottom: var(--line); padding: 10px 18px; font-family: var(--display); font-weight: 800; font-stretch: 80%; text-transform: uppercase; letter-spacing: .02em; }
  .id-top .hand { text-transform: none; font-size: 1.2rem; }
  .id-body { display: flex; gap: 20px; align-items: center; padding: 20px 20px 46px; }
  dl { margin: 0; display: grid; gap: 8px; flex: 1; }
  dl div { display: grid; grid-template-columns: 80px 1fr; gap: 10px; border-bottom: 2px dotted rgb(23 21 15 / .25); padding-bottom: 6px; }
