---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
import Marquee from '../components/Marquee.astro';
import PawTrail from '../components/PawTrail.astro';
import ArticleCard from '../components/ArticleCard.astro';
import DogFinder from '../components/DogFinder.astro';
import OsloTip from '../components/OsloTip.astro';
import { programs, steps, prices, site } from '../data/site';
import paulineOslo from '../assets/photos/pauline-oslo.jpg';
import osloBalle from '../assets/photos/oslo-balle.jpg';
import riviere from '../assets/photos/riviere.jpg';
import frisbee from '../assets/photos/frisbee.jpg';
import osloChiot from '../assets/photos/oslo-chiot.jpg';
import osloLabrador from '../assets/photos/oslo-labrador.jpg';

const articles = (await getCollection('conseils')).sort((a, b) => a.data.order - b.data.order).slice(0, 3);
const struggles = ['Il tire en laisse', 'Il ne revient pas au rappel', 'Il aboie quand je pars', 'Il réagit aux autres chiens', 'Il détruit tout', 'Il garde ses jouets', 'Il saute sur les gens', 'Il fugue', 'Je viens d’adopter un chiot'];
---
<Layout>
  <!-- HERO -->
  <section class="hero">
    <div class="blob" style="width:520px;height:520px;background:var(--accent-soft);top:-200px;right:-160px"></div>
    <div class="blob" style="width:460px;height:460px;background:var(--green-soft);bottom:-200px;left:-200px"></div>
    <div class="w hero-grid">
      <div class="hero-txt">
        <span class="chip rv"><span class="dot"></span> Éducatrice &amp; comportementaliste canin · Lyon 7</span>
        <h1 class="rv" style="--d:1">
          Un lien de <span class="draw">confiance<svg viewBox="0 0 300 20" preserveAspectRatio="none" aria-hidden="true"><path d="M4 14 C 60 4, 140 4, 296 12" /></svg></span>,<br />pour avancer ensemble.
        </h1>
        <p class="lead rv" style="--d:2">
          Réactivité, aboiements, anxiété, chiot qui découvre le monde… Je vous aide à comprendre votre chien et vous donne des outils concrets pour un quotidien serein.
        </p>
        <div class="rv finder-slot" style="--d:3" id="mon-chien"><DogFinder /></div>
        <p class="direct rv" style="--d:3">ou <a href="/contact/">réserver directement une séance bilan</a> · <a href="/offres/">voir les offres</a></p>
        <ul class="trust rv" style="--d:4">
          <li><Icon name="award" size={20} /> Diplômée EFM &amp; ACACED</li>
          <li><Icon name="heart" size={20} /> Méthodes bienveillantes</li>
          <li><Icon name="pin" size={20} /> À domicile, Lyon &amp; alentours</li>
        </ul>
      </div>
      <div class="hero-visual rv" style="--d:2">
        <div class="photo main parallax" data-speed="0.06">
          <Image src={paulineOslo} alt="Pauline Renard accroupie dans un parc avec son chien Oslo" widths={[400, 675]} sizes="(min-width: 1000px) 480px, 90vw" loading="eager" fetchpriority="high" />
        </div>
        <div class="photo mini parallax" data-speed="-0.08">
          <Image src={osloBalle} alt="Oslo, bouvier de l’Entlebuch, une balle dans la gueule" widths={[240, 400]} sizes="200px" loading="eager" />
        </div>
        <div class="float f1"><span class="big">35 €</span><span>la séance bilan</span></div>
        <div class="float f2"><Icon name="paw" size={22} /><span><strong>Oslo</strong><br />chien régulateur</span></div>
        <PawTrail class="hero-trail" />
      </div>
    </div>
  </section>

  <Marquee items={['Éducation de base', 'Chiots', 'Réactivité', 'Anxiété de séparation', 'Rappel', 'Marche en laisse', 'Confiance']} />

  <!-- STRUGGLES -->
  <section>
    <div class="w">
      <div class="head center rv">
        <span class="eyebrow">Vous vous reconnaissez ?</span>
        <h2>Chaque difficulté a <span class="em">sa solution</span>.</h2>
        <p class="lead">Quand le quotidien avec votre chien devient source de stress ou de frustration, il est difficile de savoir comment réagir. Vous n’êtes pas seul·e.</p>
      </div>
      <div class="bubbles">
        {struggles.map((s, i) => <span class="bubble rv" style={`--d:${i % 5}`}>« {s} »</span>)}
      </div>
      <div class="narrow" style="margin:0 auto">
        <OsloTip title="Le saviez-vous ?">
          <p>Beaucoup de ces comportements viennent du <strong>métier d’origine</strong> de la race : un berger qui poursuit les vélos, un terrier qui creuse… <a href="#mon-chien">Présentez-moi votre chien</a> pour découvrir le sien !</p>
        </OsloTip>
      </div>
    </div>
  </section>

  <!-- PROGRAMS -->
  <section class="alt">
    <div class="w">
      <div class="head-row">
        <div class="head rv">
          <span class="eyebrow">Mes accompagnements</span>
          <h2>Pour chaque chien, un chemin adapté.</h2>
        </div>
        <a class="btn ghost rv" href="/accompagnements/">Tout découvrir <Icon name="arrow" size={18} /></a>
      </div>
      <div class="grid g4">
        {programs.map((p, i) => (
          <a class="card hover prog rv" href={`/accompagnements/#${p.slug}`} style={`--d:${i}`}>
            <span class="emo">{p.emoji}</span>
            <h3>{p.title}</h3>
            <p class="mut">{p.lead}</p>
            <span class="more">En savoir plus <Icon name="arrow" size={16} /></span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- METHOD -->
  <section>
    <div class="w method">
      <div class="method-side">
        <div class="head rv">
          <span class="eyebrow">Ma méthode</span>
          <h2>Comprendre avant d’éduquer.</h2>
          <p class="lead">J’identifie avec vous les causes des comportements gênants, puis on transforme ces défis en un apprentissage positif et durable.</p>
        </div>
        <div class="photo rv sticky-photo"><Image src={osloChiot} alt="Un chiot et Oslo couchés dans l’herbe d’un parc" widths={[400, 675]} sizes="(min-width: 900px) 500px, 90vw" /></div>
      </div>
      <ol class="steps">
        {steps.map((s, i) => (
          <li class="step rv" style={`--d:${i}`}>
            <span class="n">{s.n}</span>
            <div><h3>{s.title}</h3><p class="mut">{s.text}</p></div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- OSLO -->
  <section class="oslo">
    <div class="w grid g2 oslo-grid">
      <div class="oslo-photos rv">
        <div class="photo o1"><Image src={osloBalle} alt="Oslo qui rapporte sa balle orange" widths={[400, 675]} sizes="(min-width: 760px) 400px, 80vw" /></div>
        <div class="photo o2"><Image src={osloLabrador} alt="Oslo assis à côté d’un labrador chocolat" widths={[300, 500]} sizes="260px" /></div>
      </div>
      <div class="rv" style="--d:1">
        <span class="eyebrow">Mon binôme</span>
        <h2>Oslo, mon chien régulateur.</h2>
        <p class="lead">Oslo est un bouvier de l’Entlebuch de 8 ans, très calme et très bien codé.</p>
        <p class="mut">Selon les situations, il peut servir de chien régulateur : un partenaire idéal pour aider les chiens à apprendre les bons codes canins et à se sentir en confiance face à leurs congénères.</p>
        <div class="stats">
          <div><strong>8 ans</strong><span>de sagesse canine</span></div>
          <div><strong>2</strong><span>diplômes : EFM &amp; ACACED</span></div>
          <div><strong>0</strong><span>méthode coercitive</span></div>
        </div>
      </div>
    </div>
  </section>

  <!-- PRICES TEASER -->
  <section class="alt">
    <div class="w">
      <div class="head center rv">
        <span class="eyebrow">Tarifs</span>
        <h2>Simple et transparent.</h2>
        <p class="lead">Une séance bilan pour faire connaissance, puis des séances ou des forfaits adaptés à votre chien.</p>
      </div>
      <div class="grid g4">
        {prices.map((p, i) => (
          <div class:list={['card', 'hover', 'price-card', 'rv', { featured: p.featured }]} style={`--d:${i}`}>
            {p.featured && <span class="chip orange tag">Le plus choisi</span>}
            <h3>{p.name}</h3>
            <p class="price"><span>{p.price}</span> €</p>
            <p class="mut small">{p.unit}</p>
          </div>
        ))}
      </div>
      <p class="center rv" style="margin-top:36px"><a class="btn" href="/offres/">Détail des offres et formats <Icon name="arrow" size={18} /></a></p>
    </div>
  </section>

  <!-- GALLERY -->
  <section>
    <div class="w">
      <div class="head rv">
        <span class="eyebrow">Au fil des balades</span>
        <h2>Sur le terrain, à Lyon.</h2>
      </div>
      <div class="bento">
        <div class="photo b1 rv"><Image src={riviere} alt="Trois chiens qui se baignent au bord du Rhône" widths={[400, 675]} sizes="(min-width: 900px) 40vw, 90vw" loading="lazy" /></div>
        <div class="photo b2 rv" style="--d:1"><Image src={frisbee} alt="Chienne couchée dans le trèfle avec un frisbee rouge" widths={[300, 500]} sizes="(min-width: 900px) 25vw, 45vw" loading="lazy" /></div>
        <div class="photo b3 rv" style="--d:2"><Image src={osloChiot} alt="Un chiot bouvier observe Oslo" widths={[400, 675]} sizes="(min-width: 900px) 35vw, 90vw" loading="lazy" /></div>
        <div class="photo b4 rv" style="--d:3"><Image src={paulineOslo} alt="Pauline et Oslo jouent avec un bâton" widths={[300, 500]} sizes="(min-width: 900px) 25vw, 45vw" loading="lazy" /></div>
      </div>
    </div>
  </section>

  <!-- ARTICLES -->
  <section class="alt">
    <div class="w">
      <div class="head-row">
        <div class="head rv">
          <span class="eyebrow">Conseils</span>
          <h2>Mes conseils pour le quotidien.</h2>
        </div>
        <a class="btn ghost rv" href="/conseils/">Tous les conseils <Icon name="arrow" size={18} /></a>
      </div>
      <div class="grid g3">
        {articles.map((a, i) => <ArticleCard entry={a} d={i} />)}
      </div>
    </div>
  </section>

  <section style="padding-bottom:0"></section>
</Layout>

<style>
  .hero { padding: clamp(28px, 5vw, 60px) 0 clamp(70px, 9vw, 110px); overflow: hidden; }
  .hero-grid { display: grid; gap: 56px; align-items: center; }
  @media (min-width: 1000px) { .hero-grid { grid-template-columns: 1.1fr .9fr; } }
  .hero h1 { margin: 18px 0 22px; }
  .dot { width: 8px; height: 8px; border-radius: 50%; background: var(--green); box-shadow: 0 0 0 0 var(--green); animation: pulse 2.2s infinite; }
  @keyframes pulse { 70% { box-shadow: 0 0 0 10px transparent; } 100% { box-shadow: 0 0 0 0 transparent; } }
  .draw { position: relative; white-space: nowrap; color: var(--green); font-style: italic; }
  .draw svg { position: absolute; left: 0; bottom: -.12em; width: 100%; height: .35em; overflow: visible; }
  .draw path { fill: none; stroke: var(--accent); stroke-width: 6; stroke-linecap: round; stroke-dasharray: 320; stroke-dashoffset: 320; animation: draw 1.2s .7s var(--ease) forwards; }
  @keyframes draw { to { stroke-dashoffset: 0; } }
  .lead { max-width: 54ch; }
  .finder-slot { margin-top: 28px; max-width: 560px; scroll-margin-top: 100px; }
  .direct { margin: 14px 0 0 6px; color: var(--mut); font-size: .95rem; }
  .trust { list-style: none; padding: 0; margin: 30px 0 0; display: flex; flex-wrap: wrap; gap: 10px 24px; color: var(--mut); font-size: .95rem; }
  .trust li { display: inline-flex; align-items: center; gap: 8px; }
  .trust :global(svg) { color: var(--green); }

  .hero-visual { position: relative; max-width: 520px; margin: 0 auto; width: 100%; padding: 0 0 40px 40px; }
  .main { aspect-ratio: 4 / 5; border-radius: 200px 200px 36px 36px; }
  .mini { position: absolute; left: 0; bottom: 0; width: 38%; aspect-ratio: 3 / 4; border: 6px solid var(--bg); border-radius: 28px; }
  .float { position: absolute; display: flex; align-items: center; gap: 10px; background: var(--card); border: 1px solid var(--line); border-radius: 18px; padding: 12px 16px; box-shadow: var(--shadow-lg); font-size: .9rem; line-height: 1.25; animation: bob 5s ease-in-out infinite; }
  .f1 { top: 12%; right: -14px; flex-direction: column; align-items: flex-start; gap: 0; }
  .f1 .big { font-family: var(--serif); font-size: 1.8rem; color: var(--accent); font-weight: 700; line-height: 1; }
  .f1 span:last-child { color: var(--mut); }
  .f2 { bottom: 22%; right: -6px; animation-delay: -2.5s; }
  .f2 :global(svg) { color: var(--accent); }
  @media (max-width: 600px) { .f1 { right: 0; } .f2 { right: 0; } }
  @keyframes bob { 50% { transform: translateY(-10px); } }
  .hero-visual :global(.hero-trail) { position: absolute; width: 90%; left: -12%; top: -6%; z-index: -1; opacity: .7; transform: rotate(-12deg); }

  .bubbles { display: flex; flex-wrap: wrap; justify-content: center; gap: 12px; max-width: 900px; margin: 0 auto; }
  .bubble { background: var(--card); border: 1px solid var(--line); padding: 12px 20px; border-radius: 999px; font-family: var(--serif); font-style: italic; font-size: clamp(1rem, 1.6vw, 1.15rem); box-shadow: var(--shadow); transition: transform .4s var(--ease), background .3s, color .3s, opacity .9s var(--ease); }
  .bubble:hover { transform: translateY(-4px) rotate(-1.5deg); background: var(--green); color: var(--on); }

  .head-row { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: flex-end; gap: 20px; margin-bottom: clamp(36px, 5vw, 56px); }
  .head-row .head { margin-bottom: 0; }
  .prog { text-decoration: none; color: inherit; display: flex; flex-direction: column; }
  .prog .mut { flex: 1; }
  .emo { display: grid; place-items: center; width: 60px; height: 60px; border-radius: 18px; background: var(--bg2); font-size: 1.8rem; margin-bottom: 18px; transition: transform .5s var(--ease); }
  .prog:hover .emo { transform: rotate(-8deg) scale(1.1); }
  .more { display: inline-flex; align-items: center; gap: 6px; font-weight: 700; color: var(--green); }

  .method { display: grid; gap: 48px; }
  @media (min-width: 900px) { .method { grid-template-columns: 1fr 1fr; gap: 72px; } .sticky-photo { position: sticky; top: 110px; } }
  .sticky-photo { aspect-ratio: 4 / 3; }
  .steps { list-style: none; padding: 0; margin: 0; display: grid; gap: 18px; align-content: start; }
  .step { display: flex; gap: 20px; background: var(--card); border: 1px solid var(--line); border-radius: var(--r); padding: 26px; box-shadow: var(--shadow); }
  .step .n { flex: none; font-family: var(--serif); font-size: 2.4rem; font-weight: 700; line-height: 1; color: var(--accent); width: 64px; }
  .step p { margin: 0; }

  .oslo-grid { align-items: center; gap: 56px; }
  .oslo-photos { position: relative; padding: 0 60px 60px 0; }
  .o1 { aspect-ratio: 3 / 4; transform: rotate(-3deg); }
  .o2 { position: absolute; right: 0; bottom: 0; width: 46%; aspect-ratio: 3 / 4; border: 6px solid var(--bg); transform: rotate(5deg); }
  .stats { display: grid; grid-template-columns: repeat(3, 1fr); gap: 14px; margin-top: 30px; }
  .stats div { background: var(--card); border: 1px solid var(--line); border-radius: 20px; padding: 18px; }
  .stats strong { display: block; font-family: var(--serif); font-size: 2rem; color: var(--green); line-height: 1.1; }
  .stats span { font-size: .85rem; color: var(--mut); line-height: 1.3; display: block; }

  .price-card { position: relative; text-align: center; }
  .price-card.featured { border: 2px solid var(--accent); }
  .tag { position: absolute; top: -14px; left: 50%; transform: translateX(-50%); white-space: nowrap; background: var(--accent); color: #fff; }
  .price { font-family: var(--serif); font-size: 1.4rem; color: var(--accent); margin: 6px 0 0; font-weight: 700; }
  .price span { font-size: 3.2rem; }
  .small { font-size: .92rem; margin: 0; }

  .bento { display: grid; gap: 16px; grid-template-columns: 1fr 1fr; }
  .bento .photo { aspect-ratio: 1; }
  .b1, .b3 { grid-column: span 2; aspect-ratio: 4 / 3 !important; }
  @media (min-width: 900px) {
    .bento { grid-template-columns: 1.3fr 1fr 1.2fr; grid-template-rows: 260px 260px; }
    .bento .photo { aspect-ratio: auto !important; }
    .b1 { grid-column: 1; grid-row: span 2; }
    .b2 { grid-column: 2; grid-row: 1; }
    .b3 { grid-column: 3; grid-row: span 2; }
    .b4 { grid-column: 2; grid-row: 2; }
  }
  .bento .photo img { transition: transform 1.2s var(--ease); }
  .bento .photo:hover img { transform: scale(1.06); }
</style>

<script>
  function parallax() {
    const els = [...document.querySelectorAll<HTMLElement>('.parallax')];
    if (!els.length || matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    let raf = 0;
    const run = () => {
      raf = 0;
      els.forEach((el) => { el.style.transform = `translateY(${scrollY * Number(el.dataset.speed)}px)`; });
    };
    const onScroll = () => { if (!raf) raf = requestAnimationFrame(run); };
    addEventListener('scroll', onScroll, { passive: true });
    document.addEventListener('astro:before-swap', () => removeEventListener('scroll', onScroll), { once: true });
  }
  document.addEventListener('astro:page-load', parallax);
</script>
