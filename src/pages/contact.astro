---
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
import Icon from '../components/Icon.astro';
import Kicker from '../components/Kicker.astro';
import Faq from '../components/Faq.astro';
import OsloTip from '../components/OsloTip.astro';
import { site, prices, programs } from '../data/site';
const motifs = [...programs.map((p) => p.title), 'Anxiété de séparation', 'Réactivité (humains / congénères)', 'Séance bilan', 'Autre'];
---
<Layout title="Contact" description="Contactez Pauline Renard, éducatrice canine à Lyon 7 : décrivez votre situation pour convenir d’une séance bilan. 06 45 81 64 19.">
  <PageHero kicker="Contact" title='Parlons de <span class="hl">votre chien</span>.' lead="Décrivez-moi votre situation, je reviens vers vous rapidement pour convenir d’une séance bilan." color="lilac" illus="plane" oslo />

  <section class="ct-s">
    <div class="w layout">
      <aside class="side" data-reveal="stagger">
        <a class="ct bg-sun" href={site.phoneHref}><span class="ico"><Icon name="phone" /></span><span><small>Téléphone</small><strong>{site.phone}</strong></span></a>
        <a class="ct bg-sky" href={`mailto:${site.email}`}><span class="ico"><Icon name="mail" /></span><span><small>E-mail</small><strong>{site.email}</strong></span></a>
        <div class="ct bg-mint"><span class="ico"><Icon name="pin" /></span><span><small>Zone d’intervention</small><strong>{site.city} · {site.area}</strong></span></div>
        <OsloTip size={80} title="Le mot d’Oslo"><p>La <strong>séance bilan à 35 €</strong>, c’est le point de départ idéal : on fait connaissance et Pauline vous propose un plan adapté.</p></OsloTip>
      </aside>

      <div class="form-card" data-reveal>
        <p class="fc-title hand">Votre message ↓</p>
        <form id="f" novalidate>
          <div class="two">
            <label>Votre nom<input name="nom" required autocomplete="name" /></label>
            <label>Votre e-mail<input type="email" name="email" required autocomplete="email" /></label>
          </div>
          <div class="two">
            <label>Téléphone <span class="opt">(facultatif)</span><input type="tel" name="tel" autocomplete="tel" /></label>
            <label>Nom, âge et race du chien<input name="chien" placeholder="Ex. : Oslo, 8 ans, bouvier" /></label>
          </div>
          <div class="two">
            <label>Votre besoin<select name="motif" id="motif">{motifs.map((m) => <option>{m}</option>)}</select></label>
            <label>Formule envisagée<select name="offre" id="offre"><option>Je ne sais pas encore</option>{prices.map((p) => <option>{p.name}</option>)}</select></label>
          </div>
          <label>Votre message<textarea name="msg" rows="6" required placeholder="Depuis quand, dans quels contextes, ce que vous avez déjà essayé…"></textarea></label>
          <input type="text" name="_honey" class="hp" tabindex="-1" autocomplete="off" aria-hidden="true" />
          <button class="btn tomato" type="submit"><span class="lbl">Envoyer ma demande</span> <Icon name="arrow" size={18} /></button>
          <p class="msg" id="ok" role="status" aria-live="polite"></p>
        </form>
      </div>
    </div>
  </section>

  <section class="bg-sand">
    <div class="w narrow">
      <div class="center head"><Kicker>Questions fréquentes</Kicker><h2 data-split>Avant de me contacter</h2></div>
      <Faq />
    </div>
  </section>
</Layout>

<style>
  .ct-s { padding-top: clamp(40px, 6vw, 70px); }
  .head { margin-bottom: clamp(36px, 5vw, 56px); }
  .layout { display: grid; gap: 32px; align-items: start; }
  @media (min-width: 980px) { .layout { grid-template-columns: .8fr 1.2fr; gap: 48px; } .side { position: sticky; top: 110px; } }
  .side { display: grid; gap: 14px; }
  .ct { display: flex; gap: 16px; align-items: center; border: var(--line); border-radius: 22px; padding: 16px 18px; text-decoration: none; box-shadow: 4px 4px 0 var(--ink); transition: transform .35s var(--spring), box-shadow .3s; overflow-wrap: anywhere; }
  a.ct:hover { transform: translate(-2px, -3px) rotate(-1deg); box-shadow: 6px 7px 0 var(--ink); }
  .ct small { display: block; font-size: .8rem; font-weight: 700; text-transform: uppercase; letter-spacing: .08em; }
  .ct strong { font-size: 1.05rem; }
  .ico { flex: none; display: grid; place-items: center; width: 50px; height: 50px; border-radius: 50%; border: var(--line); background: var(--white); }
  .form-card { position: relative; background: var(--white); border: var(--line); border-radius: 30px; padding: clamp(24px, 4vw, 40px); box-shadow: var(--hard-lg); }
  .fc-title { position: absolute; top: -22px; left: 28px; background: var(--sun); border: var(--line); border-radius: 12px; padding: 2px 14px; font-size: 1.5rem; rotate: -3deg; margin: 0; }
  form { display: grid; gap: 18px; }
  .two { display: grid; gap: 18px; }
  @media (min-width: 620px) { .two { grid-template-columns: 1fr 1fr; } }
  label { display: grid; gap: 6px; font-weight: 700; font-size: .93rem; }
  .opt { font-weight: 400; color: var(--ink2); }
  input, select, textarea { font: inherit; font-weight: 400; padding: 14px 16px; border-radius: 14px; border: var(--line); background: var(--paper); color: var(--ink); width: 100%; transition: box-shadow .25s, background .25s, transform .25s; }
  input:focus, select:focus, textarea:focus { outline: none; background: var(--white); box-shadow: 4px 4px 0 var(--sun); transform: translate(-2px, -2px); }
  .invalid { background: #ffe3dc !important; border-color: var(--tomato) !important; }
  .hp { position: absolute; left: -9999px; }
  form .btn { justify-self: start; }
  form .btn[disabled] { opacity: .7; cursor: wait; }
  .msg { margin: 0; font-weight: 700; }
  .msg.ok { color: var(--grass); }
  .msg.err { color: #c8341a; }
</style>

<script>
  import { site } from '../data/site';
  import { stages } from '../data/groups';
  import { loadDog } from '../lib/dog';
  function init() {
    const f = document.querySelector<HTMLFormElement>('#f');
    if (!f) return;
    const q = new URLSearchParams(location.search);
    const pick = (id: string, v: string | null) => {
      const s = f.querySelector<HTMLSelectElement>(id);
      if (!s || !v) return;
      const o = [...s.options].find((o) => o.text === v || v.startsWith(o.text) || o.text.startsWith(v));
      if (o) s.value = o.text;
    };
    pick('#offre', q.get('offre'));
    pick('#motif', q.get('motif'));
    // prefill the dog field from the URL or the profile saved with Oslo
    const chien = f.querySelector<HTMLInputElement>('[name=chien]')!;
    const dog = loadDog();
    if (q.get('chien')) chien.value = q.get('chien')!;
    else if (dog && !chien.value) chien.value = `${dog.nom}, ${stages.find((s) => s.key === dog.age)?.label ?? ''}, ${dog.race}`;

    const ok = f.querySelector<HTMLElement>('#ok')!;
    const btn = f.querySelector<HTMLButtonElement>('button[type=submit]')!;
    const lbl = btn.querySelector<HTMLElement>('.lbl')!;
    f.addEventListener('submit', async (e) => {
      e.preventDefault();
      let valid = true;
      f.querySelectorAll<HTMLInputElement>('[required]').forEach((el) => {
        const bad = !el.checkValidity();
        el.classList.toggle('invalid', bad);
        if (bad && valid) { el.focus(); valid = false; }
      });
      if (!valid) { ok.className = 'msg err'; ok.textContent = 'Merci de compléter les champs obligatoires.'; return; }
      const o: Record<string, string> = Object.fromEntries(new FormData(f) as any);
      if (o._honey) return;
      Object.assign(o, { _subject: `Nouvelle demande via le site – ${o.motif}`, _captcha: 'false', _template: 'table' });
      btn.disabled = true; lbl.textContent = 'Envoi en cours…'; ok.textContent = '';
      try {
        const r = await fetch(`https://formsubmit.co/ajax/${site.email}`, { method: 'POST', headers: { 'Content-Type': 'application/json', Accept: 'application/json' }, body: JSON.stringify(o) });
        // FormSubmit answers 200 with success "false" (e.g. form not activated yet): treat it as a failure.
        const res = await r.json().catch(() => ({}));
        if (!r.ok || String(res.success) !== 'true') throw new Error(res.message);
        ok.className = 'msg ok'; ok.textContent = 'Merci ! Votre message a bien été envoyé, je vous réponds rapidement. 🐶';
        f.reset();
      } catch {
        ok.className = 'msg err'; ok.textContent = `L’envoi a échoué. Écrivez-moi directement à ${site.email} ou appelez le ${site.phone}.`;
      } finally {
        btn.disabled = false; lbl.textContent = 'Envoyer ma demande';
      }
    });
  }
  init();
</script>
