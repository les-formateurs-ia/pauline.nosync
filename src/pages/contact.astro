---
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
import Icon from '../components/Icon.astro';
import Faq from '../components/Faq.astro';
import OsloTip from '../components/OsloTip.astro';
import { site, prices, programs } from '../data/site';
const motifs = [...programs.map((p) => p.title), 'Anxiété de séparation', 'Réactivité (humains / congénères)', 'Séance bilan', 'Autre'];
---
<Layout title="Contact" description="Contactez Pauline Renard, éducatrice canine à Lyon 7 : décrivez votre situation pour convenir d’une séance bilan. 06 45 81 64 19.">
  <PageHero label="Contact" title="Parlons de <em>votre chien</em>." lead="Décrivez-moi votre situation, je reviens vers vous rapidement pour convenir d’une séance bilan." />

  <section>
    <div class="w layout">
      <aside class="side" data-reveal="stagger">
        <a class="ct" href={site.phoneHref}><span class="icon-c"><Icon name="phone" size={20} /></span><span><small>Téléphone</small><strong>{site.phone}</strong></span></a>
        <a class="ct" href={`mailto:${site.email}`}><span class="icon-c"><Icon name="mail" size={20} /></span><span><small>E-mail</small><strong>{site.email}</strong></span></a>
        <div class="ct"><span class="icon-c"><Icon name="pin" size={20} /></span><span><small>Zone d’intervention</small><strong>{site.city} · {site.area}</strong></span></div>
        <OsloTip title="Bon à savoir"><p>La <strong>séance bilan à 35 €</strong> est le point de départ idéal : on fait connaissance et je vous propose un plan adapté.</p></OsloTip>
      </aside>

      <div class="form-card" data-reveal>
        <form id="f" novalidate>
          <div class="two">
            <label>Votre nom<input name="nom" required autocomplete="name" /></label>
            <label>Votre e-mail<input type="email" name="email" required autocomplete="email" /></label>
          </div>
          <div class="two">
            <label>Téléphone <span class="opt">(facultatif)</span><input type="tel" name="tel" autocomplete="tel" /></label>
            <label>Nom, âge et race du chien<input name="chien" placeholder="Ex. : Oslo, 8 ans, bouvier" /></label>
          </div>
          <div class="two">
            <label>Votre besoin<select name="motif" id="motif">{motifs.map((m) => <option>{m}</option>)}</select></label>
            <label>Formule envisagée<select name="offre" id="offre"><option>Je ne sais pas encore</option>{prices.map((p) => <option>{p.name}</option>)}</select></label>
          </div>
          <label>Votre message<textarea name="msg" rows="6" required placeholder="Depuis quand, dans quels contextes, ce que vous avez déjà essayé…"></textarea></label>
          <input type="text" name="_honey" class="hp" tabindex="-1" autocomplete="off" aria-hidden="true" />
          <button class="btn sage" type="submit"><span class="lbl">Envoyer ma demande</span> <Icon name="arrow" size={17} /></button>
          <p class="msg" id="ok" role="status" aria-live="polite"></p>
        </form>
      </div>
    </div>
  </section>

  <section class="bg-stone">
    <div class="w narrow">
      <div class="head center"><p class="label">Questions fréquentes</p><h2 data-split>Avant de me contacter</h2></div>
      <Faq />
    </div>
  </section>
</Layout>

<style>
  .layout { display: grid; gap: 40px; align-items: start; }
  @media (min-width: 980px) { .layout { grid-template-columns: .8fr 1.2fr; gap: 64px; } .side { position: sticky; top: 110px; } }
  .side { display: grid; gap: 0; border-top: 1px solid var(--line); }
  .ct { display: flex; gap: 16px; align-items: center; padding: 20px 0; border-bottom: 1px solid var(--line); text-decoration: none; overflow-wrap: anywhere; }
  a.ct:hover strong { color: var(--sage); }
  .ct small { display: block; font-size: .75rem; font-weight: 600; letter-spacing: .12em; text-transform: uppercase; color: var(--ink3); }
  .ct strong { font-weight: 500; transition: color .2s; }
  .form-card { background: var(--white); border: 1px solid var(--line); border-radius: var(--r-lg); padding: clamp(26px, 4vw, 44px); }
  form { display: grid; gap: 20px; }
  .two { display: grid; gap: 20px; }
  @media (min-width: 620px) { .two { grid-template-columns: 1fr 1fr; } }
  label { display: grid; gap: 8px; font-weight: 500; font-size: .9rem; }
  .opt { font-weight: 400; color: var(--ink3); }
  input, select, textarea { font: inherit; font-weight: 400; padding: 14px 16px; border-radius: 10px; border: 1px solid var(--line); background: var(--paper); color: var(--ink); width: 100%; transition: border-color .2s, box-shadow .2s, background .2s; }
  input:focus, select:focus, textarea:focus { outline: none; background: var(--white); border-color: var(--sage); box-shadow: 0 0 0 3px var(--sage-l); }
  .invalid { border-color: var(--clay) !important; background: var(--clay-l) !important; }
  .hp { position: absolute; left: -9999px; }
  form .btn { justify-self: start; }
  form .btn[disabled] { opacity: .7; cursor: wait; }
  .msg { margin: 0; font-weight: 500; }
  .msg.ok { color: var(--sage); }
  .msg.err { color: var(--clay); }
</style>

<script>
  import { site } from '../data/site';
  import { stages } from '../data/groups';
  import { loadDog } from '../lib/dog';
  function init() {
    const f = document.querySelector<HTMLFormElement>('#f');
    if (!f) return;
    const q = new URLSearchParams(location.search);
    const pick = (id: string, v: string | null) => {
      const s = f.querySelector<HTMLSelectElement>(id);
      if (!s || !v) return;
      const o = [...s.options].find((o) => o.text === v || v.startsWith(o.text) || o.text.startsWith(v));
      if (o) s.value = o.text;
    };
    pick('#offre', q.get('offre'));
    pick('#motif', q.get('motif'));
    // prefill the dog field from the URL or the profile saved with Oslo
    const chien = f.querySelector<HTMLInputElement>('[name=chien]')!;
    const dog = loadDog();
    if (q.get('chien')) chien.value = q.get('chien')!;
    else if (dog && !chien.value) chien.value = `${dog.nom}, ${stages.find((s) => s.key === dog.age)?.label ?? ''}, ${dog.race}`;

    const ok = f.querySelector<HTMLElement>('#ok')!;
    const btn = f.querySelector<HTMLButtonElement>('button[type=submit]')!;
    const lbl = btn.querySelector<HTMLElement>('.lbl')!;
    f.addEventListener('submit', async (e) => {
      e.preventDefault();
      let valid = true;
      f.querySelectorAll<HTMLInputElement>('[required]').forEach((el) => {
        const bad = !el.checkValidity();
        el.classList.toggle('invalid', bad);
        if (bad && valid) { el.focus(); valid = false; }
      });
      if (!valid) { ok.className = 'msg err'; ok.textContent = 'Merci de compléter les champs obligatoires.'; return; }
      const o: Record<string, string> = Object.fromEntries(new FormData(f) as any);
      if (o._honey) return;
      Object.assign(o, { _subject: `Nouvelle demande via le site – ${o.motif}`, _captcha: 'false', _template: 'table' });
      btn.disabled = true; lbl.textContent = 'Envoi en cours…'; ok.textContent = '';
      try {
        const r = await fetch(`https://formsubmit.co/ajax/${site.email}`, { method: 'POST', headers: { 'Content-Type': 'application/json', Accept: 'application/json' }, body: JSON.stringify(o) });
        // FormSubmit answers 200 with success "false" (e.g. form not activated yet): treat it as a failure.
        const res = await r.json().catch(() => ({}));
        if (!r.ok || String(res.success) !== 'true') throw new Error(res.message);
        ok.className = 'msg ok'; ok.textContent = 'Merci ! Votre message a bien été envoyé, je vous réponds rapidement. 🐶';
        f.reset();
      } catch {
        ok.className = 'msg err'; ok.textContent = `L’envoi a échoué. Écrivez-moi directement à ${site.email} ou appelez le ${site.phone}.`;
      } finally {
        btn.disabled = false; lbl.textContent = 'Envoyer ma demande';
      }
    });
  }
  init();
</script>
