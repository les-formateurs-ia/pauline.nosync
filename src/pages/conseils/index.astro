---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import PageHero from '../../components/PageHero.astro';
import ArticleCard from '../../components/ArticleCard.astro';
const articles = (await getCollection('conseils')).sort((a, b) => a.data.order - b.data.order);
const cats = ['Tous', ...new Set(articles.map((a) => a.data.category))];
---
<Layout title="Conseils" description="Rappel, marche en laisse, chiot, anxiété de séparation, réactivité : les conseils d’éducation canine de Pauline Renard, éducatrice à Lyon.">
  <PageHero label="Conseils" title="Des clés pour mieux <em>comprendre</em> votre chien." lead="Des conseils simples et bienveillants, issus du terrain. Pour une situation précise, rien ne remplace une séance adaptée à votre chien.">
    <div class="filters" role="group" aria-label="Filtrer par thème">
      {cats.map((c, i) => <button type="button" data-f={c} aria-pressed={i === 0 ? 'true' : 'false'}>{c}</button>)}
    </div>
  </PageHero>
  <section>
    <div class="w grid g3 list" data-reveal="stagger">
      {articles.map((a) => <ArticleCard entry={a} />)}
    </div>
  </section>
</Layout>
<style>
  .filters { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 30px; }
  .filters button { font: inherit; font-size: .92rem; padding: 9px 18px; border: 1px solid var(--line); border-radius: 999px; background: var(--white); color: var(--ink2); cursor: pointer; transition: background .2s, color .2s, border-color .2s; }
  .filters button:hover { border-color: var(--ink); color: var(--ink); }
  .filters button[aria-pressed='true'] { background: var(--ink); border-color: var(--ink); color: var(--paper); }
  .list { row-gap: 56px; }
  .list :global(.art.hide) { display: none; }
</style>
<script>
  const btns = document.querySelectorAll<HTMLButtonElement>('[data-f]');
  btns.forEach((b) => b.addEventListener('click', () => {
    const f = b.dataset.f;
    btns.forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
    const apply = () => document.querySelectorAll<HTMLElement>('.list .art').forEach((a) => a.classList.toggle('hide', f !== 'Tous' && a.dataset.cat !== f));
    document.startViewTransition ? document.startViewTransition(apply) : apply();
  }));
</script>
