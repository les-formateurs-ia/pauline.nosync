---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import PageHero from '../../components/PageHero.astro';
import ArticleCard from '../../components/ArticleCard.astro';
const articles = (await getCollection('conseils')).sort((a, b) => a.data.order - b.data.order);
const cats = ['Tous', ...new Set(articles.map((a) => a.data.category))];
const catColor: Record<string, string> = { Tous: 'white', Éducation: 'sun', Comportement: 'pink', Chiot: 'sky', Quotidien: 'mint' };
---
<Layout title="Conseils" description="Rappel, marche en laisse, chiot, anxiété de séparation, réactivité : les conseils d’éducation canine de Pauline Renard, éducatrice à Lyon.">
  <PageHero kicker="Conseils" title='Des clés pour mieux <span class="hl">comprendre</span> votre chien.' lead="Des conseils simples et bienveillants, issus du terrain. Pour une situation précise, rien ne remplace une séance adaptée à votre chien." color="pink" illus="bulb" oslo>
    <div class="filters" role="group" aria-label="Filtrer par thème">
      {cats.map((c, i) => <button type="button" data-f={c} aria-pressed={i === 0 ? 'true' : 'false'} style={`--c:var(--${catColor[c]})`}>{c}</button>)}
    </div>
  </PageHero>
  <section class="list-s">
    <div class="w grid g3 list" data-reveal="stagger">
      {articles.map((a, i) => <ArticleCard entry={a} i={i} />)}
    </div>
  </section>
</Layout>
<style>
  .filters { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 26px; }
  .filters button { font: inherit; font-weight: 700; padding: 10px 18px; border: var(--line); border-radius: 999px; background: var(--white); cursor: pointer; box-shadow: 3px 3px 0 var(--ink); transition: transform .3s var(--spring), background .2s, box-shadow .3s; }
  .filters button:hover { transform: translate(-2px, -2px); }
  .filters button[aria-pressed='true'] { background: var(--c); transform: rotate(-3deg); box-shadow: 5px 5px 0 var(--ink); }
  .list-s { padding-top: clamp(40px, 6vw, 70px); }
  .list { row-gap: 40px; }
  .list :global(.art.hide) { display: none; }
</style>
<script>
  const btns = document.querySelectorAll<HTMLButtonElement>('[data-f]');
  btns.forEach((b) => b.addEventListener('click', () => {
    const f = b.dataset.f;
    btns.forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
    const apply = () => document.querySelectorAll<HTMLElement>('.list .art').forEach((a) => a.classList.toggle('hide', f !== 'Tous' && a.dataset.cat !== f));
    document.startViewTransition ? document.startViewTransition(apply) : apply();
  }));
</script>
