---
import { Image } from 'astro:assets';
import { getCollection, render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import Icon from '../../components/Icon.astro';
import OsloTip from '../../components/OsloTip.astro';

export async function getStaticPaths() {
  const all = await getCollection('conseils');
  return all.map((entry) => ({ params: { slug: entry.id }, props: { entry, all } }));
}
const { entry, all } = Astro.props;
const { Content } = await render(entry);
const { title, description, category, cover, coverAlt, readingTime } = entry.data;
const related = all.filter((a) => a.id !== entry.id).sort((a, b) => Number(b.data.category === category) - Number(a.data.category === category)).slice(0, 3);
---
<Layout title={title} description={description} image={cover} type="article">
  <div class="progress" aria-hidden="true"></div>
  <article>
    <header class="ah" data-hero>
      <div class="w narrow">
        <a class="back" href="/conseils/"><Icon name="arrow" size={15} /> Tous les conseils</a>
        <p class="label">{category} <span class="n">· {readingTime} min de lecture</span></p>
        <h1 data-split>{title}</h1>
        <p class="lead" data-reveal>{description}</p>
      </div>
    </header>
    <div class="w"><div class="photo cover" data-img><Image src={cover} alt={coverAlt} widths={[480, 675, 900]} sizes="(min-width: 1240px) 1180px, 94vw" loading="eager" /></div></div>
    <div class="w narrow prose"><Content /></div>
    {entry.data.oslo && <div class="w narrow"><OsloTip><p>{entry.data.oslo}</p></OsloTip></div>}
    <div class="w narrow">
      <aside class="box" data-reveal>
        <p class="label">Accompagnement personnalisé</p>
        <p class="t">Chaque chien est unique.</p>
        <p class="muted">Lors d’une séance bilan, on analyse votre situation et je vous propose un plan adapté.</p>
        <a class="btn sage" href="/contact/">Réserver une séance bilan <Icon name="arrow" size={17} /></a>
      </aside>
    </div>
  </article>
  <section class="bg-stone">
    <div class="w">
      <div class="head"><p class="label">À lire aussi</p><h2 data-split>D’autres conseils.</h2></div>
      <div class="grid g3" data-reveal="stagger">{related.map((a) => <ArticleCard entry={a} />)}</div>
    </div>
  </section>
</Layout>
<style>
  .progress { position: fixed; top: 0; left: 0; height: 2px; width: 100%; background: var(--sage); transform-origin: 0 50%; transform: scaleX(0); z-index: 60; }
  @supports (animation-timeline: scroll()) { .progress { animation: grow linear both; animation-timeline: scroll(root); } @keyframes grow { to { transform: scaleX(1); } } }
  .ah { padding: clamp(48px, 7vw, 96px) 0 clamp(40px, 5vw, 64px); }
  .back { display: inline-flex; align-items: center; gap: 8px; font-size: .9rem; color: var(--ink2); text-decoration: none; margin-bottom: 30px; }
  .back :global(svg) { transform: rotate(180deg); }
  .back:hover { color: var(--ink); }
  .ah h1 { font-size: clamp(2.4rem, 5.4vw, 4.2rem); }
  .cover { aspect-ratio: 21 / 9; margin-bottom: clamp(48px, 6vw, 80px); }
  @media (max-width: 700px) { .cover { aspect-ratio: 4 / 3; } }
  .prose { font-size: 1.1rem; line-height: 1.75; color: #33362f; }
  .prose :global(h2) { font-size: clamp(1.6rem, 3vw, 2.1rem); margin-top: 1.8em; color: var(--ink); }
  .prose :global(h3) { margin-top: 1.5em; color: var(--ink); }
  .prose :global(ul), .prose :global(ol) { padding-left: 1.2em; }
  .prose :global(li) { margin-bottom: .45em; }
  .prose :global(li::marker) { color: var(--sage); }
  .prose :global(strong) { color: var(--ink); font-weight: 600; }
  .prose :global(blockquote) { margin: 2em 0; padding: 4px 0 4px 26px; border-left: 2px solid var(--sage); font-family: var(--serif); font-style: italic; font-size: 1.35rem; line-height: 1.5; color: var(--ink); }
  .prose :global(blockquote p:last-child) { margin: 0; }
  .box { margin: 56px 0 clamp(72px, 9vw, 120px); padding: 36px; background: var(--sage-l); border-radius: var(--r-lg); }
  .box .t { font-family: var(--display); font-weight: 500; font-size: 1.8rem; letter-spacing: -.025em; line-height: 1.1; margin-bottom: 8px; }
</style>
