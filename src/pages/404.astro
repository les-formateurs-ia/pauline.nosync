---
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
import OsloAvatar from '../components/OsloAvatar.astro';
---
<Layout title="Page introuvable">
  <section class="nf">
    <div class="w center">
      <OsloAvatar size={110} mood="calm" />
      <p class="label" style="margin-top:28px">Erreur 404</p>
      <h1 data-split>Cette page est <em>introuvable</em>.</h1>
      <p class="lead" style="margin:0 auto 32px">Même Oslo ne la retrouve pas, et pourtant il a du flair.</p>
      <a class="btn sage" href="/">Retour à l’accueil <Icon name="arrow" size={17} /></a>
    </div>
  </section>
</Layout>
<style>
  .nf { min-height: 70vh; display: grid; place-items: center; }
  .nf :global(.oslo) { margin: 0 auto; }
</style>
