---
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
import OsloAvatar from '../components/OsloAvatar.astro';
import Illus from '../components/Illus.astro';
---
<Layout title="Page introuvable">
  <section class="nf">
    <div class="w center">
      <div class="big" aria-hidden="true"><span>4</span><span class="o oslo-host"><OsloAvatar size={190} /></span><span>4</span></div>
      <h1 data-split>Cette page a fugué…</h1>
      <p class="lead" style="margin:0 auto 30px">Même Oslo ne la retrouve pas, et pourtant il a du flair. On travaille le rappel, promis !</p>
      <a class="btn tomato" href="/">Retour à l’accueil <Icon name="arrow" size={18} /></a>
      <div class="paws" aria-hidden="true"><Illus name="paws" size={160} /></div>
    </div>
  </section>
</Layout>
<style>
  .nf { min-height: 72vh; display: grid; place-items: center; overflow: hidden; }
  .big { display: flex; justify-content: center; align-items: center; gap: 10px; font-family: var(--display); font-weight: 800; font-stretch: 75%; font-size: clamp(9rem, 26vw, 16rem); line-height: .8; margin-bottom: 20px; }
  .o { display: inline-grid; animation: look 3s ease-in-out infinite; }
  @keyframes look { 0%, 100% { transform: rotate(0); } 25% { transform: rotate(-14deg) translateX(-6px); } 75% { transform: rotate(14deg) translateX(6px); } }
  .paws { display: flex; justify-content: center; margin-top: 30px; }
  @media (max-width: 600px) { .o :global(.oslo) { width: 120px; height: 120px; } }
</style>
