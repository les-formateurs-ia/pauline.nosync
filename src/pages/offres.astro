---
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
import Icon from '../components/Icon.astro';
import LIcon from '../components/LIcon.astro';
import Faq from '../components/Faq.astro';
import OsloTip from '../components/OsloTip.astro';
import { prices, formats } from '../data/site';
const fmtIcon: Record<string, string> = { home: 'house', tree: 'trees', paw: 'paw', chat: 'chat' };
const picks = [
  { tag: 'Éducation de base · chiot', text: 'Le forfait 3 séances pose des bases solides et permet de suivre les progrès.' },
  { tag: 'Trouble du comportement', text: 'Le forfait 5 séances laisse le temps de travailler en profondeur et de généraliser les acquis.' },
  { tag: 'Besoin ponctuel', text: 'La séance individuelle convient à un objectif précis ou à un point d’étape.' },
];
---
<Layout title="Offres & tarifs" description="Séance bilan à 35 €, séance individuelle à 45 €, forfaits 3 et 5 séances : les offres d’éducation canine de Pauline Renard à Lyon.">
  <PageHero label="Offres & tarifs" title="Des formules <em>claires</em>, adaptées à votre chien." lead="Tout commence par une séance bilan pour faire connaissance. Ensuite, on choisit ensemble : séance à l’unité ou forfait à tarif avantageux." />

  <section>
    <div class="w">
      <div class="plans" data-reveal="stagger">
        {prices.map((p) => (
          <article class:list={['plan', { featured: p.featured }]}>
            {p.featured && <span class="badge">Le plus choisi</span>}
            <h2 class="pname">{p.name}</h2>
            <p class="pitch">{p.pitch}</p>
            <p class="price">{p.price} €</p>
            <p class="unit">{p.unit}</p>
            <hr class="rule" />
            <ul class="check">{p.features.map((f) => <li>{f}</li>)}</ul>
            <a class:list={['btn', p.featured ? 'sage' : 'ghost']} href={`/contact/?offre=${encodeURIComponent(p.name)}`}>Choisir cette formule</a>
          </article>
        ))}
      </div>
      <div class="info" data-reveal>
        <p><LIcon name="list" size={20} /> Paiement par virement ou en espèces</p>
        <p><LIcon name="route" size={20} /> Basée à Lyon 7 · déplacements dans Lyon et alentours</p>
      </div>
    </div>
  </section>

  <section class="bg-stone">
    <div class="w">
      <div class="head"><p class="label">Les formats</p><h2 data-split>Là où votre chien <em>en a besoin</em>.</h2></div>
      <div class="grid g4" data-reveal="stagger">
        {formats.map((f) => (
          <div class="card hover fmt">
            <span class="icon-c"><LIcon name={fmtIcon[f.icon]} /></span>
            <h3>{f.title}</h3>
            <p>{f.text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section>
    <div class="w choose">
      <div>
        <p class="label">Quelle formule choisir ?</p>
        <h2 data-split>Quelques repères pour <em>vous orienter</em>.</h2>
        <OsloTip><p>Pas sûr·e ? La séance bilan est faite pour ça : Pauline vous conseille la formule la plus adaptée à la fin du rendez-vous.</p></OsloTip>
      </div>
      <ul class="picks" data-reveal="stagger">
        {picks.map((p) => <li><span class="ptag">{p.tag}</span><p>{p.text}</p></li>)}
      </ul>
    </div>
  </section>

  <section class="bg-stone">
    <div class="w narrow">
      <div class="head center"><p class="label">Questions fréquentes</p><h2 data-split>Vous vous demandez…</h2></div>
      <Faq />
    </div>
  </section>
</Layout>

<style>
  .plans { display: grid; gap: 20px; }
  @media (min-width: 700px) { .plans { grid-template-columns: 1fr 1fr; } }
  @media (min-width: 1140px) { .plans { grid-template-columns: repeat(4, 1fr); } }
  .plan { position: relative; display: flex; flex-direction: column; background: var(--white); border: 1px solid var(--line); border-radius: var(--r-lg); padding: 32px 28px 28px; transition: transform .4s var(--ease), box-shadow .4s; }
  .plan:hover { transform: translateY(-3px); box-shadow: var(--shadow); }
  .plan.featured { border-color: var(--sage); box-shadow: inset 0 0 0 1px var(--sage); }
  .badge { position: absolute; top: 20px; right: 20px; font-size: .72rem; font-weight: 600; letter-spacing: .08em; text-transform: uppercase; color: var(--sage-d); background: var(--sage-l); padding: 5px 10px; border-radius: 999px; }
  .pname { font-size: 1.35rem; margin-bottom: 6px; padding-right: 90px; }
  .pitch { font-size: .95rem; color: var(--ink2); min-height: 3em; }
  .price { font-family: var(--display); font-weight: 400; font-size: 3.4rem; letter-spacing: -.04em; line-height: 1; margin: 10px 0 6px; }
  .unit { font-size: .9rem; color: var(--ink3); margin-bottom: 22px; }
  .plan .check { flex: 1; margin: 22px 0 28px; font-size: .95rem; }
  .info { display: flex; flex-wrap: wrap; justify-content: center; gap: 14px 40px; margin-top: 44px; color: var(--ink2); font-size: .95rem; }
  .info p { display: flex; align-items: center; gap: 10px; margin: 0; }
  .info :global(svg) { color: var(--sage); }
  .fmt h3 { margin: 22px 0 10px; }
  .fmt p { color: var(--ink2); font-size: .96rem; margin: 0; }
  .choose { display: grid; gap: 48px; align-items: start; }
  @media (min-width: 960px) { .choose { grid-template-columns: 1fr 1fr; gap: 90px; } }
  .picks { list-style: none; padding: 0; margin: 0; border-top: 1px solid var(--line); }
  .picks li { padding: 28px 0; border-bottom: 1px solid var(--line); }
  .ptag { font-size: .78rem; font-weight: 600; letter-spacing: .12em; text-transform: uppercase; color: var(--sage); }
  .picks p { margin: 8px 0 0; font-family: var(--display); font-size: 1.3rem; letter-spacing: -.015em; line-height: 1.35; }
</style>
