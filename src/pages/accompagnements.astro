---
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
import Icon from '../components/Icon.astro';
import LIcon from '../components/LIcon.astro';
import OsloTip from '../components/OsloTip.astro';
import { programs } from '../data/site';
import frisbee from '../assets/photos/frisbee.jpg';
import osloChiot from '../assets/photos/oslo-chiot.jpg';
import osloLabrador from '../assets/photos/oslo-labrador.jpg';
import riviere from '../assets/photos/riviere.jpg';
const look = [
  { icon: 'target', img: frisbee, alt: 'Chienne couchée calmement dans l’herbe, un frisbee devant elle' },
  { icon: 'sprout', img: osloChiot, alt: 'Un chiot découvre le parc aux côtés d’Oslo' },
  { icon: 'heart', img: osloLabrador, alt: 'Oslo et un labrador posés côte à côte' },
  { icon: 'house', img: riviere, alt: 'Plusieurs chiens détendus au bord du Rhône' },
];
---
<Layout title="Accompagnements" description="Éducation de base, chiots, anxiété de séparation, réactivité, protection de ressources, fugues, changements de vie : les accompagnements de Pauline Renard à Lyon.">
  <PageHero label="Accompagnements" title="Comprendre votre chien, <em>pas à pas</em>." lead="Bonnes bases ou trouble du comportement : j’identifie avec vous les causes et vous donne des outils pratiques pour guider votre chien.">
    <nav class="jump" aria-label="Accès rapide">
      {programs.map((p, i) => <a href={`#${p.slug}`}><span>0{i + 1}</span> {p.title}</a>)}
    </nav>
  </PageHero>

  {programs.map((p, i) => (
    <section id={p.slug} class:list={['prog', { 'bg-stone': i % 2 === 1 }]}>
      <div class:list={['w', 'row', { rev: i % 2 === 1 }]}>
        <div class="photo pimg" data-img><Image src={look[i].img} alt={look[i].alt} widths={[400, 675]} sizes="(min-width: 900px) 500px, 90vw" /></div>
        <div>
          <p class="label"><span class="n">0{i + 1}</span> <LIcon name={look[i].icon} size={16} /></p>
          <h2 data-split>{p.title}</h2>
          <p class="lead" data-reveal>{p.lead}</p>
          <ul class="check cols2" data-reveal="stagger">{p.items.map((it) => <li>{it}</li>)}</ul>
          <p class="sugg" data-reveal><span>Formule conseillée</span><strong>{p.suggested}</strong></p>
          <a class="btn sage" href={`/contact/?motif=${encodeURIComponent(p.title)}`}>En parler avec moi <Icon name="arrow" size={17} /></a>
          <OsloTip><p>{p.oslo}</p></OsloTip>
        </div>
      </div>
    </section>
  ))}
</Layout>

<style>
  .jump { display: flex; flex-wrap: wrap; gap: 8px 28px; margin-top: 30px; }
  .jump a { font-size: .95rem; text-decoration: none; color: var(--ink2); padding: 4px 0; border-bottom: 1px solid var(--line); transition: color .2s, border-color .2s; }
  .jump a span { font-family: var(--serif); font-style: italic; color: var(--sage); margin-right: 4px; }
  .jump a:hover { color: var(--ink); border-color: var(--ink); }
  .prog { scroll-margin-top: 40px; }
  .row { display: grid; gap: 56px; align-items: start; }
  @media (min-width: 960px) { .row { grid-template-columns: .85fr 1.15fr; gap: 90px; } .rev .pimg { order: 2; } .pimg { position: sticky; top: 120px; } }
  .pimg { aspect-ratio: 4 / 5; }
  @media (max-width: 959px) { .pimg { aspect-ratio: 16 / 10; } }
  .label :global(svg) { color: var(--sage); }
  .cols2 { margin: 30px 0; }
  @media (min-width: 560px) { .cols2 { grid-template-columns: 1fr 1fr; } }
  .sugg { display: grid; gap: 2px; padding: 16px 0; border-top: 1px solid var(--line); border-bottom: 1px solid var(--line); margin-bottom: 28px; }
  .sugg span { font-size: .75rem; font-weight: 600; letter-spacing: .12em; text-transform: uppercase; color: var(--ink3); }
  .sugg strong { font-weight: 500; }
</style>
