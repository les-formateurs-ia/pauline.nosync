---
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
import Icon from '../components/Icon.astro';
import LIcon from '../components/LIcon.astro';
import OsloTip from '../components/OsloTip.astro';
import paulineOslo from '../assets/photos/pauline-oslo.jpg';
import osloBalle from '../assets/photos/oslo-balle.jpg';
const values = [
  { icon: 'handheart', title: 'Bienveillance', text: 'Des méthodes respectueuses du chien, fondées sur la compréhension de ses émotions et de ses besoins.' },
  { icon: 'ear', title: 'Écoute', text: 'Chaque famille est unique : je pars de votre quotidien et de vos contraintes pour construire des solutions réalistes.' },
  { icon: 'list', title: 'Concret', text: 'Des outils pratiques, simples à appliquer, pour que vous soyez autonome entre les séances.' },
];
---
<Layout title="À propos" description="Pauline Renard, éducatrice et comportementaliste canin diplômée (EFM Métiers Animaliers, ACACED), basée à Lyon 7, et Oslo, son chien régulateur.">
  <PageHero label="À propos" title="Pauline Renard, <em>éducatrice</em> et comportementaliste canin." lead="J’accompagne les familles lyonnaises pour construire avec leur chien une relation fondée sur la confiance mutuelle." image={paulineOslo} alt="Pauline Renard avec Oslo dans un parc ensoleillé" />

  <section>
    <div class="w story">
      <div>
        <p class="label">Mon approche</p>
        <h2 data-split>Chaque difficulté a <em>sa solution</em>.</h2>
      </div>
      <div class="story-txt" data-reveal>
        <p class="lead">Quand le quotidien avec son chien devient une source de stress ou de frustration, il est parfois difficile de savoir comment réagir.</p>
        <p>Qu’il s’agisse d’acquérir les bonnes bases d’éducation ou de résoudre des troubles du comportement (réactivité en balade, aboiements, anxiété, destruction…), je vous aide à identifier les causes de ces comportements et vous donne des outils pratiques pour guider votre chien pas à pas.</p>
        <p>Ensemble, nous transformons ces défis en un apprentissage positif et durable, afin de retrouver un quotidien serein.</p>
        <div class="diplomas">
          <div><LIcon name="cap" size={26} /><span><strong>EFM Métiers Animaliers</strong>Diplômée éducatrice et comportementaliste canin</span></div>
          <div><LIcon name="cap" size={26} /><span><strong>ACACED</strong>Attestation de connaissances pour les animaux de compagnie</span></div>
        </div>
      </div>
    </div>
  </section>

  <section class="bg-stone">
    <div class="w">
      <div class="head"><p class="label">Mes valeurs</p><h2 data-split>Ce qui guide <em>mon travail</em>.</h2></div>
      <div class="grid g3" data-reveal="stagger">
        {values.map((v) => (
          <div class="card hover val">
            <span class="icon-c"><LIcon name={v.icon} /></span>
            <h3>{v.title}</h3>
            <p>{v.text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section>
    <div class="w row">
      <div class="photo oimg" data-img><Image src={osloBalle} alt="Oslo debout dans l’herbe, une balle dans la gueule" widths={[400, 675]} sizes="(min-width: 900px) 460px, 90vw" /></div>
      <div>
        <p class="label">Mon binôme</p>
        <h2 data-split>Oslo, bouvier de <em>l’Entlebuch</em>.</h2>
        <p class="lead" data-reveal>8 ans, très calme et très bien codé.</p>
        <p class="muted" data-reveal>Selon les situations, Oslo peut servir de chien régulateur. C’est un partenaire idéal pour aider les chiens à apprendre les bons codes et à se sentir en confiance : un chien réactif ou un chiot timide peut progresser au contact d’un congénère stable et rassurant.</p>
        <OsloTip title="Oslo se présente"><p>Ma spécialité : rester calme quand un congénère s’agite. C’est souvent comme ça que la confiance revient.</p></OsloTip>
        <a class="btn sage" href="/contact/">Rencontrer Pauline &amp; Oslo <Icon name="arrow" size={17} /></a>
      </div>
    </div>
  </section>
</Layout>

<style>
  .story { display: grid; gap: 40px; }
  @media (min-width: 960px) { .story { grid-template-columns: .8fr 1.2fr; gap: 90px; } }
  .story-txt p:not(.lead) { color: var(--ink2); }
  .diplomas { display: grid; gap: 0; margin-top: 34px; border-top: 1px solid var(--line); }
  .diplomas > div { display: flex; gap: 18px; align-items: flex-start; padding: 20px 0; border-bottom: 1px solid var(--line); }
  .diplomas :global(svg) { color: var(--sage); flex: none; margin-top: 2px; }
  .diplomas strong { display: block; font-weight: 600; }
  .diplomas span { color: var(--ink2); font-size: .95rem; }
  .val h3 { margin: 22px 0 10px; }
  .val p { color: var(--ink2); margin: 0; }
  .row { display: grid; gap: 56px; align-items: center; }
  @media (min-width: 960px) { .row { grid-template-columns: .85fr 1.15fr; gap: 90px; } }
  .oimg { aspect-ratio: 4 / 5; }
</style>
