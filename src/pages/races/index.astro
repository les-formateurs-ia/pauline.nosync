---
import Layout from '../../layouts/Layout.astro';
import PageHero from '../../components/PageHero.astro';
import DogFinder from '../../components/DogFinder.astro';
import OsloTip from '../../components/OsloTip.astro';
import OsloAvatar from '../../components/OsloAvatar.astro';
import Kicker from '../../components/Kicker.astro';
import Illus from '../../components/Illus.astro';
import Icon from '../../components/Icon.astro';
import { groups } from '../../data/groups';
import { groupStyle } from '../../data/groupStyle';
const hints = [
  { q: 'Il suit les mouvements, rassemble, vous colle ?', slug: 'bergers-bouviers' },
  { q: 'Il garde la maison, se méfie des inconnus ?', slug: 'molosses-gardiens' },
  { q: 'Il creuse, chasse les petites bêtes, ne lâche rien ?', slug: 'terriers' },
  { q: 'Il est indépendant, fugueur, peu câlin ?', slug: 'primitifs-nordiques' },
  { q: 'Il a toujours la truffe au sol ?', slug: 'chiens-courants' },
  { q: 'Il porte tout dans sa gueule et adore l’eau ?', slug: 'rapporteurs-chiens-d-eau' },
];
---
<Layout title="Mon chien : comprendre sa race" description="Bergers, terriers, primitifs, chiens de chasse, molosses… Découvrez comment la famille de race de votre chien influence son comportement et son éducation.">
  <PageHero kicker="Mon chien" title='Comprendre votre chien <span class="hl">grâce à ses origines</span>.' lead="Chaque race a été sélectionnée pour un métier : garder, chasser, rassembler, tenir compagnie… Ces origines expliquent beaucoup de ses comportements d’aujourd’hui." color="mint" illus="paws" oslo />

  <section class="find-s" id="mon-chien">
    <div class="w">
      <div class="find-card" data-reveal>
        <p class="fc-title hand">Le guide d’Oslo ↓</p>
        <DogFinder />
      </div>
      <div data-unknown hidden>
        <OsloTip title="Enchanté !">
          <p data-v="unknown">Je n’ai pas trouvé « <strong data-race></strong> » dans ma liste. Pas de souci : si <strong data-nom></strong> est croisé, regardez les questions plus bas ou choisissez la famille qui lui ressemble le plus !</p>
          <p data-v="mixed" hidden>Un chien croisé, c’est un mélange unique ! Pour mieux comprendre <strong data-nom></strong>, répondez aux questions plus bas ou choisissez la famille qui lui ressemble le plus.</p>
        </OsloTip>
      </div>
    </div>
  </section>

  <section class="fam-s">
    <div class="w">
      <Kicker>Les 9 familles</Kicker>
      <h2 data-split>Quel est son profil ?</h2>
      <div class="grid g3 fams" data-reveal="stagger">
        {groups.map((g, i) => (
          <a class="fam" href={`/races/${g.slug}/`} style={`--c:var(--${groupStyle[g.slug].color});--r:${[-1, 1, -.5][i % 3]}deg`}>
            <div class="fam-art"><Illus name={groupStyle[g.slug].illus} size={140} /></div>
            <div class="fam-body">
              <h3>{g.name}</h3>
              <p>{g.short}</p>
              <p class="ex hand">{g.examples.slice(0, 3).join(' · ')}…</p>
              <span class="go"><Icon name="arrow" size={18} /></span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="bg-sun">
    <div class="w mixed">
      <div>
        <Kicker>Mon chien est croisé</Kicker>
        <h2 data-split>Observez ce qui domine chez lui.</h2>
        <p class="lead" style="color:var(--ink)">Un chien croisé hérite des tendances de plusieurs familles. Ses comportements spontanés sont souvent le meilleur indice.</p>
        <div class="mascot oslo-host"><OsloAvatar size={100} /><p>Et si vous hésitez entre deux familles, lisez les deux ! Moi, je suis un bouvier pur jus, mais j’ai plein de copains croisés : ce sont souvent les plus surprenants.</p></div>
      </div>
      <ul class="hints" data-reveal="stagger">
        {hints.map((h) => {
          const g = groups.find((x) => x.slug === h.slug)!;
          return <li><a href={`/races/${g.slug}/`} style={`--c:var(--${groupStyle[g.slug].color})`}><span class="q">{h.q}</span><span class="to"><Illus name={groupStyle[g.slug].illus} size={40} /> {g.name} <Icon name="arrow" size={16} /></span></a></li>;
        })}
      </ul>
    </div>
  </section>
</Layout>

<style>
  .find-s { padding-top: clamp(50px, 6vw, 80px); padding-bottom: clamp(30px, 5vw, 60px); scroll-margin-top: 80px; }
  .find-card { position: relative; background: var(--white); border: var(--line); border-radius: 32px; padding: clamp(28px, 5vw, 56px); box-shadow: var(--hard-lg); }
  .fc-title { position: absolute; top: -22px; left: 28px; background: var(--sun); border: var(--line); border-radius: 12px; padding: 2px 14px; font-size: 1.5rem; rotate: -3deg; margin: 0; }
  [data-unknown][hidden] { display: none; }
  .fam-s h2 { margin-bottom: 44px; }
  .fams { row-gap: 34px; }
  .fam { display: flex; flex-direction: column; background: var(--white); border: var(--line); border-radius: 26px; overflow: hidden; text-decoration: none; rotate: var(--r); transition: rotate .4s var(--spring), transform .4s var(--spring), box-shadow .3s; }
  .fam:hover { rotate: 0deg; transform: translate(-4px, -6px); box-shadow: var(--hard-lg); }
  .fam-art { display: grid; place-items: center; background: var(--c); border-bottom: var(--line); padding: 14px 0 8px; }
  .fam-body { position: relative; padding: 22px 22px 24px; display: flex; flex-direction: column; flex: 1; }
  .fam-body p { color: var(--ink2); font-size: .97rem; }
  .ex { font-size: 1.2rem; color: var(--tomato) !important; margin: auto 0 0; padding-right: 50px; }
  .go { position: absolute; right: 18px; bottom: 18px; display: grid; place-items: center; width: 44px; height: 44px; border: var(--line); border-radius: 50%; background: var(--c); transition: transform .4s var(--spring); }
  .fam:hover .go { transform: rotate(-35deg) scale(1.1); }
  .mixed { display: grid; gap: 48px; align-items: center; }
  @media (min-width: 900px) { .mixed { grid-template-columns: 1fr 1fr; } }
  .mascot { display: flex; gap: 16px; align-items: center; margin-top: 24px; background: var(--white); border: var(--line); border-radius: 24px; padding: 16px; box-shadow: var(--hard); }
  .mascot p { margin: 0; }
  .hints { list-style: none; padding: 0; margin: 0; display: grid; gap: 12px; }
  .hints a { display: flex; flex-direction: column; gap: 6px; padding: 16px 20px; border: var(--line); border-radius: 20px; background: var(--white); text-decoration: none; box-shadow: 3px 3px 0 var(--ink); transition: transform .35s var(--spring), box-shadow .3s, background .2s; }
  .hints a:hover { transform: translateX(8px) rotate(-1deg); box-shadow: 5px 5px 0 var(--ink); background: var(--c); }
  .q { font-weight: 700; font-size: 1.05rem; }
  .to { display: inline-flex; align-items: center; gap: 8px; font-size: .92rem; font-weight: 600; }
</style>

<script>
  const box = document.querySelector<HTMLElement>('[data-unknown]');
  const q = new URLSearchParams(location.search);
  const race = q.get('race');
  if (box && race) {
    box.querySelector('[data-race]')!.textContent = race;
    box.querySelectorAll('[data-nom]').forEach((el) => (el.textContent = q.get('nom') || 'votre chien'));
    if (/crois|sais pas|inconnu|batard|bâtard/i.test(race)) {
      box.querySelector<HTMLElement>('[data-v="unknown"]')!.hidden = true;
      box.querySelector<HTMLElement>('[data-v="mixed"]')!.hidden = false;
    }
    box.hidden = false;
  }
</script>
