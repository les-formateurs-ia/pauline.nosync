---
import Layout from '../../layouts/Layout.astro';
import PageHero from '../../components/PageHero.astro';
import DogFinder from '../../components/DogFinder.astro';
import OsloTip from '../../components/OsloTip.astro';
import OsloAvatar from '../../components/OsloAvatar.astro';
import LIcon from '../../components/LIcon.astro';
import Icon from '../../components/Icon.astro';
import { groups } from '../../data/groups';
import { groupStyle } from '../../data/groupStyle';
const hints = [
  { q: 'Il suit les mouvements, rassemble, vous colle ?', slug: 'bergers-bouviers' },
  { q: 'Il garde la maison, se méfie des inconnus ?', slug: 'molosses-gardiens' },
  { q: 'Il creuse, chasse les petites bêtes, ne lâche rien ?', slug: 'terriers' },
  { q: 'Il est indépendant, fugueur, peu câlin ?', slug: 'primitifs-nordiques' },
  { q: 'Il a toujours la truffe au sol ?', slug: 'chiens-courants' },
  { q: 'Il porte tout dans sa gueule et adore l’eau ?', slug: 'rapporteurs-chiens-d-eau' },
];
---
<Layout title="Mon chien : comprendre sa race" description="Bergers, terriers, primitifs, chiens de chasse, molosses… Découvrez comment la famille de race de votre chien influence son comportement et son éducation.">
  <PageHero label="Mon chien" title="Comprendre votre chien <em>grâce à ses origines</em>." lead="Chaque race a été sélectionnée pour un métier : garder, chasser, rassembler, tenir compagnie… Ces origines expliquent beaucoup de ses comportements d’aujourd’hui." />

  <section class="find-s bg-stone" id="mon-chien">
    <div class="w">
      <div class="find-card" data-reveal>
        <div class="fc-head"><OsloAvatar size={44} /><span>Le guide d’Oslo</span></div>
        <DogFinder />
      </div>
      <div data-unknown hidden>
        <OsloTip title="Enchanté !">
          <p data-v="unknown">Je n’ai pas trouvé « <strong data-race></strong> » dans ma liste. Si <strong data-nom></strong> est croisé, les questions plus bas vous aideront à choisir la famille qui lui ressemble le plus.</p>
          <p data-v="mixed" hidden>Un chien croisé hérite de plusieurs familles. Pour mieux comprendre <strong data-nom></strong>, aidez-vous des questions plus bas ou choisissez la famille qui lui ressemble le plus.</p>
        </OsloTip>
      </div>
    </div>
  </section>

  <section>
    <div class="w">
      <div class="head"><p class="label">Les 9 familles</p><h2 data-split>Quel est <em>son profil</em> ?</h2></div>
      <div class="grid g3" data-reveal="stagger">
        {groups.map((g) => (
          <a class="card hover fam" href={`/races/${g.slug}/`}>
            <span class="icon-c"><LIcon name={groupStyle[g.slug].icon} /></span>
            <h3>{g.name}</h3>
            <p>{g.short}</p>
            <p class="ex">{g.examples.slice(0, 3).join(' · ')}…</p>
            <span class="more">Découvrir <Icon name="arrow" size={15} /></span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="bg-sage">
    <div class="w mixed">
      <div>
        <p class="label">Mon chien est croisé</p>
        <h2 data-split>Observez ce qui <em>domine</em> chez lui.</h2>
        <p class="lead" data-reveal>Un chien croisé hérite des tendances de plusieurs familles. Ses comportements spontanés sont souvent le meilleur indice. En cas d’hésitation, lisez les deux fiches.</p>
      </div>
      <ul class="hints" data-reveal="stagger">
        {hints.map((h) => {
          const g = groups.find((x) => x.slug === h.slug)!;
          return <li><a href={`/races/${g.slug}/`}><span class="q">{h.q}</span><span class="to"><LIcon name={groupStyle[g.slug].icon} size={16} /> {g.name} <Icon name="arrow" size={15} /></span></a></li>;
        })}
      </ul>
    </div>
  </section>
</Layout>

<style>
  .find-s { scroll-margin-top: 80px; }
  .find-card { background: var(--white); border: 1px solid var(--line); border-radius: var(--r-lg); padding: clamp(28px, 5vw, 56px); }
  .fc-head { display: flex; align-items: center; gap: 12px; margin-bottom: 26px; font-size: .78rem; font-weight: 600; letter-spacing: .14em; text-transform: uppercase; color: var(--sage); }
  [data-unknown][hidden] { display: none; }
  .fam { display: flex; flex-direction: column; text-decoration: none; }
  .fam h3 { margin: 22px 0 10px; }
  .fam p { color: var(--ink2); font-size: .96rem; }
  .ex { font-size: .88rem !important; color: var(--ink3) !important; margin-top: auto; }
  .more { display: inline-flex; align-items: center; gap: 8px; font-size: .9rem; font-weight: 500; color: var(--sage); }
  .mixed { display: grid; gap: 48px; align-items: start; }
  @media (min-width: 960px) { .mixed { grid-template-columns: 1fr 1fr; gap: 90px; } }
  .hints { list-style: none; padding: 0; margin: 0; border-top: 1px solid rgb(54 81 63 / .2); }
  .hints a { display: flex; flex-direction: column; gap: 6px; padding: 20px 0; border-bottom: 1px solid rgb(54 81 63 / .2); text-decoration: none; transition: padding .4s var(--ease); }
  .hints a:hover { padding-left: 10px; }
  .q { font-family: var(--display); font-size: 1.2rem; letter-spacing: -.015em; }
  .to { display: inline-flex; align-items: center; gap: 8px; font-size: .9rem; color: var(--sage-d); }
</style>

<script>
  const box = document.querySelector<HTMLElement>('[data-unknown]');
  const q = new URLSearchParams(location.search);
  const race = q.get('race');
  if (box && race) {
    box.querySelector('[data-race]')!.textContent = race;
    box.querySelectorAll('[data-nom]').forEach((el) => (el.textContent = q.get('nom') || 'votre chien'));
    if (/crois|sais pas|inconnu|batard|bâtard/i.test(race)) {
      box.querySelector<HTMLElement>('[data-v="unknown"]')!.hidden = true;
      box.querySelector<HTMLElement>('[data-v="mixed"]')!.hidden = false;
    }
    box.hidden = false;
  }
</script>
