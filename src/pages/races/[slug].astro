---
import { Image } from 'astro:assets';
import Layout from '../../layouts/Layout.astro';
import Icon from '../../components/Icon.astro';
import LIcon from '../../components/LIcon.astro';
import OsloAvatar from '../../components/OsloAvatar.astro';
import OsloTip from '../../components/OsloTip.astro';
import { groups, stages, type Group } from '../../data/groups';
import { groupStyle } from '../../data/groupStyle';
import { breeds } from '../../data/breeds';
import osloBalle from '../../assets/photos/oslo-balle.jpg';

export function getStaticPaths() {
  return groups.map((g) => ({ params: { slug: g.slug }, props: { g } }));
}
const { g } = Astro.props as { g: Group };
const st = groupStyle[g.slug];
const groupBreeds = breeds.filter((b) => b.group === g.slug).map((b) => b.name);
const others = groups.filter((o) => o.slug !== g.slug);
---
<Layout title={`${g.name} : comprendre et éduquer`} description={`${g.short} Comprendre le comportement des ${g.name.toLowerCase()} et adapter leur éducation, avec Pauline Renard, éducatrice canine à Lyon.`}>
  <div class="gp">
    <section class="ghero" data-hero>
      <div class="w ghero-grid">
        <div>
          <a class="back" href="/races/"><Icon name="arrow" size={15} /> Toutes les familles</a>
          <div class="dogcard" hidden data-dogcard>
            <span><strong data-dog="nom"></strong> · <span data-dog="race"></span> · <span data-dog="stage"></span></span>
            <button type="button" class="reset" data-reset>Changer de chien</button>
          </div>
          <p class="label"><LIcon name={st.icon} size={16} /> Famille de races</p>
          <h1 class="gtitle" data-split><span data-dog-title hidden><span data-dog="nom"></span> fait partie des </span><em>{g.name}</em></h1>
          <p class="lead" data-reveal>{g.short}</p>
          <ul class="traits" data-reveal="stagger">{g.traits.map((t) => <li>{t}</li>)}</ul>
        </div>
        <div class="gside" data-reveal>
          <div class="gicon"><LIcon name={st.icon} size={72} stroke={1} /></div>
          <div class="gspeech">
            <OsloAvatar size={48} />
            <p data-oslo-hello>Je vais vous expliquer comment fonctionnent les {g.name.toLowerCase()}, et comment adapter leur éducation.</p>
          </div>
        </div>
      </div>
    </section>

    <section>
      <div class="w origin">
        <div>
          <p class="label">D’où vient-il ?</p>
          <h2 data-split>Un chien façonné par son <em>métier d’origine</em>.</h2>
        </div>
        <div data-reveal>
          <p class="lead">{g.origin}</p>
          <p class="ex">Exemples : {g.examples.join(', ')}…</p>
          {g.slug === 'bergers-bouviers' && <div class="photo oimg"><Image src={osloBalle} alt="Oslo, bouvier de l’Entlebuch" widths={[400, 675]} sizes="400px" /></div>}
          <OsloTip><p>{g.oslo}</p></OsloTip>
        </div>
      </div>
    </section>

    <section class="bg-stone">
      <div class="w">
        <div class="head"><p class="label">Décrypter son comportement</p><h2 data-split>Ce que vous observez, <em>et ce que ça signifie</em>.</h2></div>
        <div class="decode" data-reveal="stagger">
          {g.decode.map((d, i) => (
            <details name="decode" open={i === 0}>
              <summary><span class="dq">« {d.obs} »</span><span class="pm" aria-hidden="true"><span></span><span></span></span></summary>
              <p class="dw"><span>Ce que ça signifie</span>{d.why}</p>
            </details>
          ))}
        </div>
      </div>
    </section>

    <section>
      <div class="w">
        <div class="head"><p class="label">Adapter l’éducation</p><h2 data-split>Comment <em>l’accompagner</em> au mieux.</h2></div>
        <div class="grid g4" data-reveal="stagger">
          {g.education.map((e, i) => (
            <div class="edu">
              <span class="n">0{i + 1}</span>
              <h3>{e.title}</h3>
              <p>{e.text}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section class="bg-sage">
      <div class="w grid g2 lists">
        <div data-reveal>
          <p class="label">Activités adaptées</p>
          <ul class="pills">{g.activities.map((a) => <li>{a}</li>)}</ul>
        </div>
        <div data-reveal>
          <p class="label">Points de vigilance</p>
          <ul class="check">{g.vigilance.map((v) => <li>{v}</li>)}</ul>
        </div>
      </div>
    </section>

    <section>
      <div class="w narrow">
        <div class="head center"><p class="label">Selon son âge</p><h2><span data-dog-age-title>Et selon l’âge ?</span></h2></div>
        <div class="tabs" role="tablist">
          {stages.map((s, i) => <button type="button" role="tab" data-stage={s.key} aria-selected={i === 2 ? 'true' : 'false'}>{s.label}</button>)}
        </div>
        {stages.map((s, i) => (
          <div class="panel" role="tabpanel" data-panel={s.key} hidden={i !== 2}>
            <h3>{s.title}</h3>
            <p>{s.text}</p>
          </div>
        ))}
      </div>
    </section>

    <section class="bg-stone">
      <div class="w">
        <div class="note" data-reveal>
          <div>
            <p class="t">Chaque chien est unique.</p>
            <p class="muted">La race donne des tendances, pas un destin : l’histoire, l’environnement et la personnalité de votre chien comptent tout autant. Pour une analyse personnalisée, rien ne remplace une séance bilan.</p>
          </div>
          <a class="btn sage" href={`/contact/?motif=${encodeURIComponent('Séance bilan')}`} data-contact>Réserver un bilan <span data-dog-for></span> <Icon name="arrow" size={17} /></a>
        </div>
        <details class="all">
          <summary>Voir les {groupBreeds.length} races de cette famille</summary>
          <p>{groupBreeds.join(' · ')}</p>
        </details>
        <p class="label others-l">Les autres familles</p>
        <div class="others">
          {others.map((o) => <a class="other" href={`/races/${o.slug}/`}><LIcon name={groupStyle[o.slug].icon} size={18} />{o.name}</a>)}
        </div>
      </div>
    </section>
  </div>
</Layout>

<style>
  .ghero { padding: clamp(40px, 6vw, 80px) 0 clamp(56px, 7vw, 90px); border-bottom: 1px solid var(--line); }
  .ghero-grid { display: grid; gap: 48px; align-items: end; }
  @media (min-width: 960px) { .ghero-grid { grid-template-columns: 1.3fr .7fr; gap: 80px; } }
  .back { display: inline-flex; align-items: center; gap: 8px; font-size: .9rem; color: var(--ink2); text-decoration: none; margin-bottom: 26px; }
  .back :global(svg) { transform: rotate(180deg); }
  .dogcard { display: flex; flex-wrap: wrap; align-items: center; gap: 14px; background: var(--sage-l); border-radius: 999px; padding: 8px 8px 8px 18px; margin-bottom: 24px; width: fit-content; font-size: .93rem; }
  .dogcard[hidden] { display: none; }
  .reset { font: inherit; font-size: .82rem; background: var(--white); border: 1px solid var(--line); border-radius: 999px; padding: 6px 12px; cursor: pointer; }
  .label :global(svg) { color: var(--sage); }
  .gtitle { font-size: clamp(2.6rem, 6vw, 5rem); }
  .traits { list-style: none; padding: 0; margin: 26px 0 0; display: flex; flex-wrap: wrap; gap: 8px; }
  .traits li { padding: 7px 14px; border: 1px solid var(--line); border-radius: 999px; background: var(--white); font-size: .9rem; color: var(--ink2); }
  .gside { display: grid; gap: 18px; }
  .gicon { display: grid; place-items: center; aspect-ratio: 1; max-width: 240px; width: 100%; border-radius: 50%; background: var(--sage-l); color: var(--sage-d); }
  .gspeech { display: flex; gap: 14px; align-items: flex-start; background: var(--white); border: 1px solid var(--line); border-radius: var(--r); padding: 16px; }
  .gspeech p { margin: 0; font-size: .93rem; color: var(--ink2); }
  .origin { display: grid; gap: 40px; }
  @media (min-width: 960px) { .origin { grid-template-columns: .8fr 1.2fr; gap: 90px; } }
  .ex { color: var(--ink3); font-size: .95rem; }
  .oimg { aspect-ratio: 4 / 3; max-width: 420px; margin-top: 20px; }
  .decode { border-top: 1px solid var(--line); }
  .decode details { border-bottom: 1px solid var(--line); }
  .decode summary { list-style: none; cursor: pointer; display: flex; justify-content: space-between; align-items: center; gap: 20px; padding: 26px 0; }
  .decode summary::-webkit-details-marker { display: none; }
  .dq { font-family: var(--display); font-size: clamp(1.15rem, 2vw, 1.45rem); letter-spacing: -.015em; }
  .pm { position: relative; flex: none; width: 36px; height: 36px; border: 1px solid var(--line); border-radius: 50%; background: var(--white); transition: transform .45s var(--ease), background .3s; }
  .pm span { position: absolute; left: 50%; top: 50%; width: 12px; height: 1.5px; background: var(--ink); transform: translate(-50%, -50%); }
  .pm span + span { transform: translate(-50%, -50%) rotate(90deg); }
  details[open] .pm { transform: rotate(45deg); background: var(--sage); border-color: var(--sage); }
  details[open] .pm span { background: #fff; }
  .dw { margin: 0 0 26px; padding-left: 20px; border-left: 2px solid var(--sage); color: var(--ink2); max-width: 70ch; }
  .dw span { display: block; font-size: .75rem; font-weight: 600; letter-spacing: .12em; text-transform: uppercase; color: var(--sage); margin-bottom: 4px; }
  .decode details::details-content { block-size: 0; overflow: hidden; transition: block-size .45s var(--ease), content-visibility .45s allow-discrete; }
  .decode details[open]::details-content { block-size: auto; }
  .edu { padding-top: 22px; border-top: 1px solid var(--ink); }
  .edu .n { font-family: var(--serif); font-style: italic; font-size: 1.6rem; color: var(--sage); }
  .edu h3 { margin: 12px 0 10px; }
  .edu p { margin: 0; color: var(--ink2); font-size: .96rem; }
  .lists { gap: 56px; align-items: start; }
  .pills { list-style: none; padding: 0; margin: 0; display: flex; flex-wrap: wrap; gap: 8px; }
  .pills li { padding: 9px 16px; border-radius: 999px; background: var(--white); font-size: .95rem; }
  .tabs { display: flex; flex-wrap: wrap; justify-content: center; gap: 8px; margin-bottom: 24px; }
  .tabs button { font: inherit; font-size: .92rem; padding: 9px 18px; border: 1px solid var(--line); border-radius: 999px; background: var(--white); color: var(--ink2); cursor: pointer; transition: background .2s, color .2s, border-color .2s; }
  .tabs button[aria-selected='true'] { background: var(--ink); border-color: var(--ink); color: var(--paper); }
  .panel { background: var(--white); border: 1px solid var(--line); border-radius: var(--r-lg); padding: 32px; animation: pin .5s var(--ease); }
  @keyframes pin { from { opacity: 0; transform: translateY(8px); } }
  .panel p { margin: 0; color: var(--ink2); font-size: 1.05rem; }
  .note { display: grid; gap: 24px; align-items: center; padding: 36px; background: var(--white); border: 1px solid var(--line); border-radius: var(--r-lg); }
  @media (min-width: 900px) { .note { grid-template-columns: 1fr auto; gap: 56px; } }
  .note .t { font-family: var(--display); font-weight: 500; font-size: 1.7rem; letter-spacing: -.025em; margin-bottom: 6px; }
  .note .muted { margin: 0; }
  .all { margin-top: 24px; padding: 18px 0; border-bottom: 1px solid var(--line); }
  .all summary { cursor: pointer; font-weight: 500; }
  .all p { margin: 12px 0 0; font-size: .93rem; color: var(--ink2); }
  .others-l { margin-top: 56px; }
  .others { display: flex; flex-wrap: wrap; gap: 10px; }
  .other { display: inline-flex; align-items: center; gap: 10px; padding: 10px 18px; border: 1px solid var(--line); border-radius: 999px; background: var(--white); font-size: .93rem; text-decoration: none; transition: border-color .2s, color .2s; }
  .other :global(svg) { color: var(--sage); }
  .other:hover { border-color: var(--sage); color: var(--sage-d); }
</style>

<script>
  import { stages, groups } from '../../data/groups';
  import { loadDog, clearDog, saveDog } from '../../lib/dog';
  function init() {
    // age tabs
    const tabs = [...document.querySelectorAll<HTMLButtonElement>('[data-stage]')];
    const select = (key: string) => {
      tabs.forEach((t) => t.setAttribute('aria-selected', String(t.dataset.stage === key)));
      document.querySelectorAll<HTMLElement>('[data-panel]').forEach((p) => (p.hidden = p.dataset.panel !== key));
    };
    tabs.forEach((t) => t.addEventListener('click', () => select(t.dataset.stage!)));

    // personalisation: URL params first, then saved profile if it matches this group
    const slug = location.pathname.split('/').filter(Boolean)[1];
    const q = new URLSearchParams(location.search);
    const saved = loadDog();
    const dog = q.get('nom')
      ? { nom: q.get('nom')!, race: q.get('race') || '', age: q.get('age') || '' }
      : saved && saved.group === slug ? saved : null;
    if (!dog) return;
    if (q.get('nom')) saveDog({ nom: dog.nom, age: dog.age, race: dog.race, group: slug });
    const stage = stages.find((s) => s.key === dog.age);
    const g = groups.find((x) => x.slug === slug)!;
    const set = (k: string, v: string) => document.querySelectorAll<HTMLElement>(`[data-dog="${k}"]`).forEach((el) => (el.textContent = v));
    set('nom', dog.nom); set('race', dog.race); set('stage', stage?.label ?? '');
    document.querySelector<HTMLElement>('[data-dogcard]')!.hidden = false;
    document.querySelector<HTMLElement>('[data-dog-title]')!.hidden = false;
    document.querySelector<HTMLElement>('[data-oslo-hello]')!.textContent =
      `Enchanté, ${dog.nom} ! Les ${g.name.toLowerCase()} ont une histoire passionnante. Voyons ensemble ce qui se cache derrière ses comportements.`;
    const forEl = document.querySelector<HTMLElement>('[data-dog-for]');
    if (forEl) forEl.textContent = `pour ${dog.nom}`;
    const c = document.querySelector<HTMLAnchorElement>('[data-contact]');
    if (c) c.href = `/contact/?motif=${encodeURIComponent('Séance bilan')}&chien=${encodeURIComponent(`${dog.nom}, ${stage?.label ?? ''}, ${dog.race}`)}`;
    if (stage) {
      select(stage.key);
      document.querySelector<HTMLElement>('[data-dog-age-title]')!.textContent = `${dog.nom} : ${stage.title.charAt(0).toLowerCase()}${stage.title.slice(1)}`;
    }
    document.querySelector('[data-reset]')?.addEventListener('click', () => { clearDog(); location.href = '/#mon-chien'; });
  }
  init();
</script>
