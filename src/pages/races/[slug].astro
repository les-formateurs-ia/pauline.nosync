---
import { Image } from 'astro:assets';
import Layout from '../../layouts/Layout.astro';
import Icon from '../../components/Icon.astro';
import Illus from '../../components/Illus.astro';
import Kicker from '../../components/Kicker.astro';
import OsloAvatar from '../../components/OsloAvatar.astro';
import OsloTip from '../../components/OsloTip.astro';
import { groups, stages, type Group } from '../../data/groups';
import { groupStyle } from '../../data/groupStyle';
import { breeds } from '../../data/breeds';
import osloBalle from '../../assets/photos/oslo-balle.jpg';

export function getStaticPaths() {
  return groups.map((g) => ({ params: { slug: g.slug }, props: { g } }));
}
const { g } = Astro.props as { g: Group };
const st = groupStyle[g.slug];
const groupBreeds = breeds.filter((b) => b.group === g.slug).map((b) => b.name);
const others = groups.filter((o) => o.slug !== g.slug);
---
<Layout title={`${g.name} : comprendre et éduquer`} description={`${g.short} Comprendre le comportement des ${g.name.toLowerCase()} et adapter leur éducation, avec Pauline Renard, éducatrice canine à Lyon.`}>
  <div class="gp" style={`--c:var(--${st.color})`}>
    <section class="ghero" data-hero>
      <div class="w ghero-grid">
        <div>
          <a class="back" href="/races/"><Icon name="arrow" size={16} /> Toutes les familles</a>
          <div class="dogcard" hidden data-dogcard>
            <span class="paw"><Icon name="paw" size={18} /></span>
            <span><strong data-dog="nom"></strong> · <span data-dog="race"></span> · <span data-dog="stage"></span></span>
            <button type="button" class="reset" data-reset>Changer de chien</button>
          </div>
          <p class="kicker hand">Famille de races</p>
          <h1 class="gtitle"><span data-dog-title hidden><span data-dog="nom"></span> fait partie des </span><span class="hl">{g.name}</span></h1>
          <p class="lead">{g.short}</p>
          <ul class="traits" data-reveal="stagger">{g.traits.map((t) => <li>{t}</li>)}</ul>
        </div>
        <div class="gart oslo-host">
          <div class="gdisc float"><Illus name={st.illus} size={250} /></div>
          <div class="gspeech">
            <OsloAvatar size={84} />
            <p data-oslo-hello>Je vais vous expliquer comment fonctionnent les {g.name.toLowerCase()}, et comment adapter leur éducation.</p>
          </div>
        </div>
      </div>
      <svg class="wave edge" viewBox="0 0 1440 40" preserveAspectRatio="none" aria-hidden="true"><path d="M0 40 V20 C 120 0, 240 0, 360 20 S 600 40, 720 20 S 960 0, 1080 20 S 1320 40, 1440 20 V40Z" /></svg>
    </section>

    <section>
      <div class="w origin">
        <div>
          <Kicker>D’où vient-il ?</Kicker>
          <h2 data-split>Un chien façonné par son métier d’origine.</h2>
          <p class="lead">{g.origin}</p>
          <p class="ex"><span class="hand">par exemple :</span> {g.examples.join(', ')}…</p>
        </div>
        <div>
          {g.slug === 'bergers-bouviers' && <figure class="polaroid tape" style="--ar:3/4;max-width:340px;rotate:3deg;margin:0 auto 10px" data-pop><Image src={osloBalle} alt="Oslo, bouvier de l’Entlebuch" widths={[400, 675]} sizes="340px" /><figcaption>Oslo, bouvier pur jus</figcaption></figure>}
          <OsloTip title="Le mot d’Oslo"><p>{g.oslo}</p></OsloTip>
        </div>
      </div>
    </section>

    <section class="bg-sand">
      <div class="w">
        <div class="head"><Kicker>Décrypter son comportement</Kicker><h2 data-split>Ce que vous observez… et ce que ça veut dire.</h2><p class="lead">Touchez une carte pour la retourner.</p></div>
        <div class="grid g2 flips" data-reveal="stagger">
          {g.decode.map((d) => (
            <button type="button" class="flip" aria-pressed="false">
              <span class="face front"><span class="q hand">« {d.obs} »</span><span class="hint">Pourquoi ? <span class="turn"><Icon name="arrow" size={16} /></span></span></span>
              <span class="face rear"><span class="lbl">Ce que ça veut dire</span><span class="why">{d.why}</span></span>
            </button>
          ))}
        </div>
      </div>
    </section>

    <section>
      <div class="w">
        <div class="head"><Kicker>Adapter l’éducation</Kicker><h2 data-split>Comment l’accompagner au mieux.</h2></div>
        <div class="grid g4" data-reveal="stagger">
          {g.education.map((e, i) => (
            <div class="edu card lift" style={`--r:${[-1, 1, -0.5, 1.2][i]}deg`}>
              <span class="n">{i + 1}</span>
              <h3>{e.title}</h3>
              <p>{e.text}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section class="bg-c">
      <div class="w grid g2 lists">
        <div class="lcard" data-reveal>
          <h3>Ce qui lui plaît</h3>
          <ul class="pills">{g.activities.map((a) => <li>{a}</li>)}</ul>
        </div>
        <div class="lcard" data-reveal>
          <h3>Points de vigilance</h3>
          <ul class="check">{g.vigilance.map((v) => <li>{v}</li>)}</ul>
        </div>
      </div>
    </section>

    <section>
      <div class="w narrow">
        <div class="head center"><Kicker>Selon son âge</Kicker><h2><span data-dog-age-title>Et selon l’âge ?</span></h2></div>
        <div class="tabs" role="tablist">
          {stages.map((s, i) => <button type="button" role="tab" data-stage={s.key} aria-selected={i === 2 ? 'true' : 'false'}>{s.label}</button>)}
        </div>
        {stages.map((s, i) => (
          <div class="panel" role="tabpanel" data-panel={s.key} hidden={i !== 2}>
            <h3>{s.title}</h3>
            <p>{s.text}</p>
          </div>
        ))}
      </div>
    </section>

    <section class="bg-sand">
      <div class="w">
        <div class="note" data-reveal>
          <OsloAvatar size={90} mood="calm" />
          <p><strong>Chaque chien est unique.</strong> La race donne des tendances, pas un destin : l’histoire, l’environnement et la personnalité de votre chien comptent tout autant. Pour une analyse vraiment personnalisée, rien ne remplace une séance bilan.</p>
          <a class="btn tomato" href={`/contact/?motif=${encodeURIComponent('Séance bilan')}`} data-contact>Réserver un bilan <span data-dog-for></span> <Icon name="arrow" size={18} /></a>
        </div>
        <details class="all">
          <summary>Voir les {groupBreeds.length} races de cette famille</summary>
          <p>{groupBreeds.join(' · ')}</p>
        </details>
        <div class="others-h"><Kicker>Les autres familles</Kicker></div>
        <div class="others" data-reveal="stagger">
          {others.map((o) => <a class="other" href={`/races/${o.slug}/`} style={`--c:var(--${groupStyle[o.slug].color})`}><Illus name={groupStyle[o.slug].illus} size={54} />{o.name}</a>)}
        </div>
      </div>
    </section>
  </div>
</Layout>

<style>
  .ghero { background: var(--c); padding: clamp(32px, 5vw, 64px) 0 clamp(90px, 10vw, 130px); overflow: hidden; }
  .ghero-grid { display: grid; gap: 40px; align-items: center; }
  @media (min-width: 960px) { .ghero-grid { grid-template-columns: 1.2fr .8fr; } }
  .back { display: inline-flex; align-items: center; gap: 8px; font-weight: 700; text-decoration: none; margin-bottom: 20px; }
  .back :global(svg) { transform: rotate(180deg); }
  .dogcard { display: flex; flex-wrap: wrap; align-items: center; gap: 10px; background: var(--white); border: var(--line); border-radius: 999px; padding: 6px 8px 6px 6px; margin-bottom: 18px; width: fit-content; box-shadow: 3px 3px 0 var(--ink); }
  .dogcard[hidden] { display: none; }
  .dogcard .paw { display: grid; place-items: center; width: 34px; height: 34px; border-radius: 50%; background: var(--tomato); border: 2px solid var(--ink); }
  .reset { font: inherit; font-size: .85rem; font-weight: 700; background: var(--sun); border: 2px solid var(--ink); border-radius: 999px; padding: 5px 12px; cursor: pointer; }
  .ghero .kicker { color: var(--ink); }
  .gtitle { font-size: clamp(2.8rem, 7vw, 6rem); }
  .ghero .lead { color: var(--ink); }
  .traits { list-style: none; padding: 0; margin: 22px 0 0; display: flex; flex-wrap: wrap; gap: 10px; }
  .traits li { padding: 8px 16px; border: var(--line); border-radius: 999px; background: var(--white); font-weight: 700; box-shadow: 3px 3px 0 var(--ink); }
  .traits li:nth-child(even) { rotate: 2deg; } .traits li:nth-child(odd) { rotate: -1.5deg; }
  .gart { display: grid; justify-items: center; gap: 22px; }
  .gdisc { display: grid; place-items: center; width: 300px; height: 300px; border-radius: 50%; background: var(--white); border: var(--line); box-shadow: var(--hard-lg); }
  .gspeech { display: flex; gap: 14px; align-items: center; max-width: 380px; background: var(--white); border: var(--line); border-radius: 22px; padding: 12px 16px 12px 12px; box-shadow: var(--hard); }
  .gspeech p { margin: 0; font-size: .98rem; }
  @media (max-width: 600px) { .gdisc { width: 220px; height: 220px; } .gdisc :global(svg) { width: 170px; height: 170px; } }
  .edge { position: absolute; left: 0; right: 0; bottom: -1px; color: var(--paper); }
  .origin { display: grid; gap: 48px; align-items: center; }
  @media (min-width: 900px) { .origin { grid-template-columns: 1.1fr .9fr; } }
  .ex .hand { font-size: 1.3rem; color: var(--tomato); }
  .head { margin-bottom: clamp(32px, 5vw, 56px); max-width: 820px; }
  .head.center { margin-inline: auto; }
  .flips { perspective: 1400px; }
  .flip { position: relative; min-height: 230px; border: 0; padding: 0; background: none; cursor: pointer; font: inherit; color: inherit; text-align: left; transform-style: preserve-3d; transition: transform .8s var(--spring); }
  .flip[aria-pressed='true'] { transform: rotateY(180deg); }
  .flip:hover:not([aria-pressed='true']) { transform: rotateY(-8deg) rotate(-1deg); }
  .face { position: absolute; inset: 0; display: flex; flex-direction: column; justify-content: space-between; gap: 14px; padding: 28px; border: var(--line); border-radius: 26px; backface-visibility: hidden; -webkit-backface-visibility: hidden; box-shadow: var(--hard); }
  .front { background: var(--white); }
  .q { font-size: clamp(1.4rem, 2.2vw, 1.75rem); line-height: 1.2; }
  .hint { display: inline-flex; align-items: center; gap: 10px; font-weight: 700; }
  .turn { display: grid; place-items: center; width: 34px; height: 34px; border: 2px solid var(--ink); border-radius: 50%; background: var(--c); }
  .rear { background: var(--c); transform: rotateY(180deg); justify-content: center; }
  .lbl { font-family: var(--hand); font-size: 1.35rem; color: var(--tomato); }
  .why { font-size: 1.05rem; font-weight: 500; }
  .edu { rotate: var(--r); }
  .edu .n { display: grid; place-items: center; width: 52px; height: 52px; margin-bottom: 14px; border: var(--line); border-radius: 50%; background: var(--c); font-family: var(--display); font-weight: 800; font-size: 1.6rem; }
  .edu p { margin: 0; color: var(--ink2); font-size: .97rem; }
  .bg-c { background: var(--c); }
  .lists { align-items: start; }
  .lcard { background: var(--white); border: var(--line); border-radius: 26px; padding: 28px; box-shadow: var(--hard); }
  .pills { list-style: none; padding: 0; margin: 0; display: flex; flex-wrap: wrap; gap: 10px; }
  .pills li { padding: 10px 16px; border: 2px solid var(--ink); border-radius: 14px; background: var(--sand); font-weight: 600; transition: transform .3s var(--spring), background .2s; }
  .pills li:hover { transform: translateY(-3px) rotate(-2deg); background: var(--sun); }
  .tabs { display: flex; flex-wrap: wrap; justify-content: center; gap: 10px; margin-bottom: 22px; }
  .tabs button { font: inherit; font-weight: 700; padding: 10px 18px; border: var(--line); border-radius: 999px; background: var(--white); cursor: pointer; transition: transform .3s var(--spring), background .2s; }
  .tabs button[aria-selected='true'] { background: var(--c); transform: rotate(-2deg) scale(1.05); box-shadow: 3px 3px 0 var(--ink); }
  .panel { background: var(--white); border: var(--line); border-radius: 26px; padding: 30px; box-shadow: var(--hard); animation: pin .5s var(--spring); }
  @keyframes pin { from { opacity: 0; transform: translateY(14px) rotate(1deg); } }
  .panel p { margin: 0; font-size: 1.08rem; }
  .note { display: grid; gap: 22px; align-items: center; background: var(--white); border: var(--line); border-radius: 28px; padding: 28px; box-shadow: var(--hard-lg); }
  @media (min-width: 900px) { .note { grid-template-columns: auto 1fr auto; } }
  .note p { margin: 0; }
  .all { margin-top: 26px; padding: 18px 22px; border: 2.5px dashed var(--ink); border-radius: 20px; }
  .all summary { cursor: pointer; font-weight: 700; }
  .all p { margin: 12px 0 0; font-size: .95rem; }
  .others-h { margin-top: 56px; }
  .others { display: flex; flex-wrap: wrap; gap: 12px; }
  .other { display: inline-flex; align-items: center; gap: 8px; padding: 6px 18px 6px 8px; border: var(--line); border-radius: 999px; background: var(--c); font-weight: 700; text-decoration: none; box-shadow: 3px 3px 0 var(--ink); transition: transform .3s var(--spring), box-shadow .3s; }
  .other:hover { transform: translate(-2px, -3px) rotate(-2deg); box-shadow: 5px 6px 0 var(--ink); }
</style>

<script>
  import { stages, groups } from '../../data/groups';
  import { loadDog, clearDog, saveDog } from '../../lib/dog';
  function init() {
    // flip cards
    document.querySelectorAll<HTMLButtonElement>('.flip').forEach((b) =>
      b.addEventListener('click', () => b.setAttribute('aria-pressed', String(b.getAttribute('aria-pressed') !== 'true')))
    );
    // age tabs
    const tabs = [...document.querySelectorAll<HTMLButtonElement>('[data-stage]')];
    const select = (key: string) => {
      tabs.forEach((t) => t.setAttribute('aria-selected', String(t.dataset.stage === key)));
      document.querySelectorAll<HTMLElement>('[data-panel]').forEach((p) => (p.hidden = p.dataset.panel !== key));
    };
    tabs.forEach((t) => t.addEventListener('click', () => select(t.dataset.stage!)));

    // personalisation: URL params first, then saved profile if it matches this group
    const slug = location.pathname.split('/').filter(Boolean)[1];
    const q = new URLSearchParams(location.search);
    const saved = loadDog();
    const dog = q.get('nom')
      ? { nom: q.get('nom')!, race: q.get('race') || '', age: q.get('age') || '' }
      : saved && saved.group === slug ? saved : null;
    if (!dog) return;
    if (q.get('nom')) saveDog({ nom: dog.nom, age: dog.age, race: dog.race, group: slug });
    const stage = stages.find((s) => s.key === dog.age);
    const g = groups.find((x) => x.slug === slug)!;
    const set = (k: string, v: string) => document.querySelectorAll<HTMLElement>(`[data-dog="${k}"]`).forEach((el) => (el.textContent = v));
    set('nom', dog.nom); set('race', dog.race); set('stage', stage?.label ?? '');
    document.querySelector<HTMLElement>('[data-dogcard]')!.hidden = false;
    document.querySelector<HTMLElement>('[data-dog-title]')!.hidden = false;
    document.querySelector<HTMLElement>('[data-oslo-hello]')!.textContent =
      `Enchanté, ${dog.nom} ! Les ${g.name.toLowerCase()} ont une histoire passionnante. Voyons ensemble ce qui se cache derrière ses comportements.`;
    const forEl = document.querySelector<HTMLElement>('[data-dog-for]');
    if (forEl) forEl.textContent = `pour ${dog.nom}`;
    const c = document.querySelector<HTMLAnchorElement>('[data-contact]');
    if (c) c.href = `/contact/?motif=${encodeURIComponent('Séance bilan')}&chien=${encodeURIComponent(`${dog.nom}, ${stage?.label ?? ''}, ${dog.race}`)}`;
    if (stage) {
      select(stage.key);
      document.querySelector<HTMLElement>('[data-dog-age-title]')!.textContent = `${dog.nom} : ${stage.title.charAt(0).toLowerCase()}${stage.title.slice(1)}`;
    }
    document.querySelector('[data-reset]')?.addEventListener('click', () => { clearDog(); location.href = '/#mon-chien'; });
  }
  init();
</script>
